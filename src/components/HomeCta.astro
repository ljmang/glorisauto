---
import { ArrowLeft, ArrowRight } from 'lucide-svelte';
import { isRtlLocale, type Locale } from '@/i18n/config';
import { parseImage, resolveLocalizedImageAltText } from '@/utils/strapiApi';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  background?: unknown;
  locale: Locale;
}

const {
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  background,
  locale,
} = Astro.props;
const backgroundImage = parseImage(background);
const backgroundAlt = resolveLocalizedImageAltText(locale, null, backgroundImage?.alt, '');
const isRtl = isRtlLocale(locale);
---

<section class="relative isolate w-full overflow-hidden bg-black py-6 sm:py-8 lg:py-10" aria-labelledby="home-cta-title">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-20 h-1 bg-black"
      aria-hidden="true"
    ></div>
    {backgroundImage?.src && (
      <>
        <img
          src={backgroundImage.src}
          alt={backgroundAlt}
          width={backgroundImage.width}
          height={backgroundImage.height}
          class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="pointer-events-none absolute inset-0 z-0 bg-black/60" aria-hidden="true"></div>
      </>
    )}
    <div class="container mx-auto px-4">
      <div
        class={`relative z-10 grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(15rem,0.8fr)] lg:items-center ${isRtl ? 'text-right' : 'text-left'}`}
        dir={isRtl ? 'rtl' : 'ltr'}
      >
        <div class="max-w-3xl">
          {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-400 sm:text-sm">{eyebrow}</p>}
          <h2 id="home-cta-title" class="mt-3 max-w-2xl text-3xl font-bold leading-[1.12] tracking-tight text-white sm:text-4xl lg:text-[2.75rem]">
            {title}
          </h2>
          {description && <p class="mt-5 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">{description}</p>}
          {(primaryLabel || secondaryLabel) && (
            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:flex-wrap">
              {primaryLabel && primaryHref && (
                <a
                  href={primaryHref}
                  class="inline-flex w-full items-center justify-center rounded-lg bg-orange-700 px-6 py-3.5 font-semibold text-white transition-colors hover:bg-orange-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black sm:w-auto"
                >
                  {primaryLabel}
                </a>
              )}
              {secondaryLabel && secondaryHref && (
                <a
                  href={secondaryHref}
                  class="group inline-flex w-full items-center justify-center gap-2 px-2 py-3.5 font-semibold text-white transition-colors hover:text-orange-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black sm:w-auto"
                >
                  {secondaryLabel}
                  {isRtl ? (
                    <ArrowLeft class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-1" aria-hidden="true" />
                  ) : (
                    <ArrowRight class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
                  )}
                </a>
              )}
            </div>
          )}
        </div>

        <div class={`hidden min-h-44 items-center lg:flex ${isRtl ? 'justify-start' : 'justify-end'}`} aria-hidden="true">
          <div class={`w-full max-w-sm py-5 ${isRtl ? 'pr-10' : 'pl-10'}`}>
            <span class={`block h-1 w-20 bg-orange-500 ${isRtl ? 'mr-0' : 'ml-0'}`}></span>
            <span class="mt-6 block text-7xl font-black tracking-[0.12em] text-white/[0.15]">B2B</span>
            <span class="mt-2 block text-xs font-semibold uppercase tracking-[0.2em] text-white/[0.55]">B2B Partnership</span>
          </div>
        </div>
      </div>
    </div>
</section>
