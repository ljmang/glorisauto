---
import { ArrowLeft, ArrowRight } from 'lucide-svelte';
import { isRtlLocale, type Locale } from '@/i18n/config';

interface Props {
  title: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  locale: Locale;
}

const { title, description, primaryLabel, primaryHref, locale } = Astro.props;
const isRtl = isRtlLocale(locale);
const cleanPrimaryLabel = primaryLabel?.replace(/[\s→←]+$/u, '').trim();
---

<section class="relative isolate w-full overflow-hidden bg-[#e4e4e4]" aria-labelledby="home-cta-title">
  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[52%] items-center justify-end overflow-hidden bg-[#e4e4e4] md:flex" aria-hidden="true">
    <img
      src="/images/cta_bg.webp"
      alt=""
      width="1800"
      height="960"
      class="block h-full w-auto max-w-none shrink-0"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="container relative mx-auto flex min-h-0 items-center px-4 py-12 sm:py-16 md:min-h-[26.25rem] lg:py-20">
    <div
      class={`relative z-10 w-full max-w-2xl ${isRtl ? 'text-right' : 'text-left'}`}
      dir={isRtl ? 'rtl' : 'ltr'}
    >
      <h2 id="home-cta-title" class="max-w-2xl text-3xl font-bold leading-[1.12] tracking-tight text-slate-950 sm:text-4xl lg:text-5xl">
        {title}
      </h2>
      {description && <p class="mt-5 max-w-xl text-base leading-7 text-slate-800 sm:text-lg">{description}</p>}
      {cleanPrimaryLabel && primaryHref && (
        <a
          href={primaryHref}
          class="group mt-8 inline-flex h-14 w-full max-w-[31rem] items-center justify-center gap-3 rounded-md bg-[#ff7000] px-6 text-xl font-semibold text-white transition-colors hover:bg-[#e86200] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ff7000] focus-visible:ring-offset-2 focus-visible:ring-offset-[#e4e4e4] sm:text-2xl"
        >
          <span>{cleanPrimaryLabel}</span>
          {isRtl ? (
            <ArrowLeft class="h-6 w-6 transition-transform duration-200 group-hover:-translate-x-1" aria-hidden="true" />
          ) : (
            <ArrowRight class="h-6 w-6 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
          )}
        </a>
      )}
    </div>
  </div>

</section>
