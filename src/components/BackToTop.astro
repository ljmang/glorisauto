---
---
<button
  id="back-to-top"
  class="fixed bottom-[95px] z-50 flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white/80 text-slate-600 shadow-lg backdrop-blur-md transition-all duration-300 ease-in-out opacity-0 translate-y-4 pointer-events-none hover:bg-orange-500 hover:text-white hover:border-transparent hover:-translate-y-1 hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 ltr:right-5 rtl:left-5"
  aria-label="Back to top"
  title="Back to top"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-5 w-5"
  >
    <path d="m18 15-6-6-6 6"/>
  </svg>
</button>

<script is:inline>
  (function () {
    const button = document.getElementById('back-to-top');
    if (!button) return;

    let isChatMaximized = false;

    // Show/hide button based on scroll position and chat widget state
    function toggleButtonVisibility() {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      const shouldShow = scrollY > 300 && !isChatMaximized;

      if (shouldShow) {
        button.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        button.classList.add('opacity-100', 'translate-y-0');
      } else {
        button.classList.remove('opacity-100', 'translate-y-0');
        button.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      }
    }

    // Scroll smoothly to top
    button.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });

    window.addEventListener('scroll', toggleButtonVisibility);

    // Integrate with Tawk_API hooks
    window.Tawk_API = window.Tawk_API || {};
    
    // Cache original hooks if they exist, or define new ones
    const originalMaximized = Tawk_API.onChatMaximized;
    Tawk_API.onChatMaximized = function () {
      if (typeof originalMaximized === 'function') {
        originalMaximized();
      }
      isChatMaximized = true;
      toggleButtonVisibility();
    };

    const originalMinimized = Tawk_API.onChatMinimized;
    Tawk_API.onChatMinimized = function () {
      if (typeof originalMinimized === 'function') {
        originalMinimized();
      }
      isChatMaximized = false;
      toggleButtonVisibility();
    };
  })();
</script>
