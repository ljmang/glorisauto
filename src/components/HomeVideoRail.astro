---
import { CircleChevronRight } from 'lucide-svelte';
import type { Locale } from '@/i18n/config';
import type { VideoAttributes } from '@/types/content';
import HomeVideoRailClient from './HomeVideoRailClient.svelte';

interface Props {
  title: string;
  description?: string;
  linkLabel?: string;
  href: string;
  videos: VideoAttributes[];
  locale: Locale;
  playLabel: string;
  previousLabel: string;
  nextLabel: string;
  closeLabel: string;
  videoUnavailableLabel: string;
}

const {
  title,
  description,
  linkLabel,
  href,
  videos,
  locale,
  playLabel,
  previousLabel,
  nextLabel,
  closeLabel,
  videoUnavailableLabel,
} = Astro.props;
---

<section class="w-full" aria-labelledby="home-videos-title">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 id="home-videos-title" class="text-3xl font-bold text-gray-950">
        {title}
      </h2>
      {description && <p class="mt-3 max-w-3xl text-base leading-7 text-gray-600 lg:text-lg">{description}</p>}
    </div>
    {linkLabel && (
      <a
        href={href}
        class="inline-flex shrink-0 items-center gap-2 text-lg text-cyan-600 transition-colors hover:text-orange-600"
      >
        {linkLabel}
        <CircleChevronRight class="h-5 w-5" aria-hidden="true" />
      </a>
    )}
  </div>

  <HomeVideoRailClient
    client:load
    title={title}
    href={href}
    videos={videos}
    locale={locale}
    playLabel={playLabel}
    previousLabel={previousLabel}
    nextLabel={nextLabel}
    closeLabel={closeLabel}
    videoUnavailableLabel={videoUnavailableLabel}
  />
</section>
