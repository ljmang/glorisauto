---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BackToTop from '@/components/BackToTop.astro';
import HomeCta from '@/components/HomeCta.astro';
import { t, type Messages, type Locale } from '@/i18n';
import {
  localeLanguageTag,
  localeOgTag,
  isRtlLocale,
  defaultLocale,
  stripLocalePrefix,
} from '@/i18n/config';
import type { HomeAttributes, SeoPageAttributes, SiteSeoAttributes } from '@/types/content';
import type { StrapiResponse, StrapiSeo } from '@/types';
import type { BreadcrumbMetaItem, JsonLdNode, SeoPageType } from '@/utils/seo';
import { resolveSeoMeta } from '@/utils/seo';
import { fetchApiWithLocaleFallback, api } from '@/utils/strapiApi';
import { toHref, transformNavigations } from '@/utils/navigationData';
import { fetchSeoPage, fetchSiteSeo } from '@/utils/siteConfig';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: unknown;
  messages: Messages;
  locale: Locale;
  seo?: StrapiSeo | null;
  pageType?: SeoPageType;
  breadcrumbs?: BreadcrumbMetaItem[];
  jsonLd?: JsonLdNode | JsonLdNode[] | null;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  siteSeo?: SiteSeoAttributes | null;
  /** Override the route-based global CTA visibility when a page needs a bespoke ending. */
  globalCta?: boolean;
}

const {
  title,
  description,
  image,
  messages,
  locale,
  seo = null,
  pageType,
  breadcrumbs,
  jsonLd = null,
  publishedTime,
  modifiedTime,
  authorName,
  siteSeo: providedSiteSeo = undefined,
  globalCta: globalCtaOverride = undefined,
} = Astro.props;

type NavItem = ReturnType<typeof transformNavigations>;

function navItemKey(item: { href: string }): string {
  return stripLocalePrefix(item.href || '/');
}

function hasDropdown(navData: NavItem): boolean {
  return navData.some((item) => Array.isArray(item.columns) && item.columns.length > 0);
}

function navPathKey(href: string | undefined): string {
  return stripLocalePrefix(href || '/');
}

function mergeNavColumns(localized: NavItem['columns'], fallback: NavItem['columns']): NavItem['columns'] {
  if (!fallback || fallback.length === 0) return localized;
  if (!localized || localized.length === 0) return fallback;

  const fallbackByPath = new Map(fallback.map((column) => [navPathKey(column.href), column]));
  const mergedLocalized = localized.map((column) => {
    const fallbackColumn = fallbackByPath.get(navPathKey(column.href));
    if (!fallbackColumn) return column;

    // A localized column is authoritative once it contains its own links.
    // Do not append fallback-language links with different paths, otherwise
    // translated category links can be followed by duplicate English detail links.
    return column.items.length > 0 ? column : { ...column, items: fallbackColumn.items };
  });

  const existingColumns = new Set(mergedLocalized.map((column) => navPathKey(column.href)));
  const missingColumns = fallback.filter((column) => !existingColumns.has(navPathKey(column.href)));
  return [...mergedLocalized, ...missingColumns];
}

function mergeNavWithFallback(localized: NavItem, fallback: NavItem): NavItem {
  const fallbackByKey = new Map(fallback.map((item) => [navItemKey(item), item]));
  const mergedLocalized = localized.map((item) => {
    const fallbackItem = fallbackByKey.get(navItemKey(item));
    if (!fallbackItem?.columns || fallbackItem.columns.length === 0) return item;
    return { ...item, columns: mergeNavColumns(item.columns, fallbackItem.columns) };
  });

  const existingKeys = new Set(mergedLocalized.map((item) => navItemKey(item)));
  const fallbackOnly = fallback.filter((item) => !existingKeys.has(navItemKey(item)));
  return [...mergedLocalized, ...fallbackOnly];
}

function localizeVideosNavigation(navData: NavItem[], videoLabel: string): NavItem[] {
  return navData.map((item) => ({
    ...item,
    columns: item.columns?.map((column) => ({
      ...column,
      title: navPathKey(column.href) === '/about/videos' ? videoLabel : column.title,
      items: column.items.map((link) => ({
        ...link,
        label: navPathKey(link.href) === '/about/videos' ? videoLabel : link.label,
      })),
    })),
  }));
}

async function getNavData(currentLocale: Locale, messages: Messages): Promise<NavItem> {
  const navigationQuery = {
    populate: {
      items: {
        populate: {
          children: {
            populate: {
              children: true,
            },
          },
        },
      },
    },
  } as const;

  const localizedRes = await fetchApiWithLocaleFallback<{ data?: unknown }>(api.navigation, {
    locale: currentLocale,
    ...navigationQuery,
  });
  const localizedNav = transformNavigations(localizedRes, currentLocale);

  if (currentLocale === defaultLocale) {
    return localizeVideosNavigation(localizedNav, t(messages, 'videos.title'));
  }

  const fallbackRes = await fetchApiWithLocaleFallback<{ data?: unknown }>(api.navigation, {
    locale: defaultLocale,
    ...navigationQuery,
  });
  const fallbackNav = transformNavigations(fallbackRes, currentLocale);
  if (!hasDropdown(fallbackNav)) return localizeVideosNavigation(localizedNav, t(messages, 'videos.title'));
  return localizeVideosNavigation(mergeNavWithFallback(localizedNav, fallbackNav), t(messages, 'videos.title'));
}

async function getSiteSeo(currentLocale: Locale): Promise<SiteSeoAttributes | null> {
  try {
    return await fetchSiteSeo(currentLocale);
  } catch (error) {
    console.error('[BaseLayout] failed to load site SEO, falling back to page defaults:', error);
    return null;
  }
}

async function getSeoPage(currentLocale: Locale, pathname: string): Promise<SeoPageAttributes | null> {
  try {
    return await fetchSeoPage(currentLocale, pathname);
  } catch (error) {
    console.error('[BaseLayout] failed to load seo page, falling back to defaults:', error);
    return null;
  }
}

type GlobalCtaAttributes = Pick<
  HomeAttributes,
  | 'ctaEnabled'
  | 'ctaTitle'
  | 'ctaDescription'
  | 'ctaPrimaryLabel'
  | 'ctaPrimaryLink'
>;

function pickLocalizedText(localized?: string | null, fallback?: string | null): string | undefined {
  const value = localized?.trim() || fallback?.trim();
  return value || undefined;
}

async function getGlobalCta(currentLocale: Locale): Promise<GlobalCtaAttributes | null> {
  try {
    const [localizedRes, fallbackRes] = await Promise.all([
      fetchApiWithLocaleFallback<StrapiResponse<GlobalCtaAttributes>>(api.home, {
        locale: currentLocale,
      }),
      currentLocale === defaultLocale
        ? Promise.resolve<StrapiResponse<GlobalCtaAttributes> | null>(null)
        : fetchApiWithLocaleFallback<StrapiResponse<GlobalCtaAttributes>>(api.home, {
            locale: defaultLocale,
          }),
    ]);

    const localized = localizedRes?.data;
    const fallback = fallbackRes?.data;
    if (!localized && !fallback) return null;

    return {
      ctaEnabled: localized?.ctaEnabled ?? fallback?.ctaEnabled ?? true,
      ctaTitle: pickLocalizedText(localized?.ctaTitle, fallback?.ctaTitle),
      ctaDescription: pickLocalizedText(localized?.ctaDescription, fallback?.ctaDescription),
      ctaPrimaryLabel: pickLocalizedText(localized?.ctaPrimaryLabel, fallback?.ctaPrimaryLabel),
      ctaPrimaryLink: pickLocalizedText(localized?.ctaPrimaryLink, fallback?.ctaPrimaryLink),
    };
  } catch (error) {
    console.error('[BaseLayout] failed to load the global CTA, skipping it for this page:', error);
    return null;
  }
}

function shouldShowGlobalCtaForPath(pathname: string): boolean {
  const path = stripLocalePrefix(pathname);
  const segments = path.split('/').filter(Boolean);

  const excludedPaths = new Set([
    '/',
    '/404',
    '/contact',
    '/cookie-preferences',
    '/privacy-policy',
    '/search',
    '/support/customer-service',
    '/thank-you',
    '/about/dealer',
  ]);
  if (excludedPaths.has(path)) return false;

  // These pages already end with a focused conversion block. Keep one clear CTA per page.
  if (segments[0] === 'solutions' && segments.length > 1) return false;
  if (segments[0] === 'about' && segments[1] === 'insights' && segments.length >= 4) return false;
  if (segments[0] === 'help' && segments.length >= 3) return false;

  return true;
}

const shouldRenderGlobalCta = globalCtaOverride ?? shouldShowGlobalCtaForPath(Astro.url.pathname);

const [navData, siteSeo, seoPage] = await Promise.all([
  getNavData(locale, messages),
  providedSiteSeo === undefined ? getSiteSeo(locale) : Promise.resolve(providedSiteSeo),
  getSeoPage(locale, Astro.url.pathname),
]);

const globalCtaData = shouldRenderGlobalCta ? await getGlobalCta(locale) : null;

const resolvedSeo = resolveSeoMeta({
  title,
  description,
  image,
  seo,
  seoPage,
  siteSeo,
  locale,
  pathname: Astro.url.pathname,
  currentOrigin: Astro.url.origin,
  pageType,
  breadcrumbs,
  extraJsonLd: jsonLd,
  publishedTime,
  modifiedTime,
  authorName,
});

const htmlLang = localeLanguageTag[locale];
const ogLocale = localeOgTag[locale];
const htmlDir = isRtlLocale(locale) ? 'rtl' : 'ltr';
const siteName = siteSeo?.siteName?.trim() || siteSeo?.companyName?.trim() || 'Gloris Auto';
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={resolvedSeo.viewport} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={resolvedSeo.robots} />
    {resolvedSeo.description && <meta name="description" content={resolvedSeo.description} />}
    {resolvedSeo.keywords && <meta name="keywords" content={resolvedSeo.keywords} />}
    {siteSeo?.googleVerification && <meta name="google-site-verification" content={siteSeo.googleVerification} />}
    {siteSeo?.bingVerification && <meta name="msvalidate.01" content={siteSeo.bingVerification} />}
    <link rel="canonical" href={resolvedSeo.canonicalUrl} />
    {resolvedSeo.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />
    ))}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-48x48.png" />
    <title>{resolvedSeo.title}</title>

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={resolvedSeo.ogType} />
    <meta property="og:title" content={resolvedSeo.ogTitle} />
    {resolvedSeo.ogDescription && <meta property="og:description" content={resolvedSeo.ogDescription} />}
    <meta property="og:url" content={resolvedSeo.canonicalUrl} />
    {resolvedSeo.ogImage && <meta property="og:image" content={resolvedSeo.ogImage} />}

    <meta name="twitter:card" content={resolvedSeo.twitterCard} />
    <meta name="twitter:title" content={resolvedSeo.twitterTitle} />
    {resolvedSeo.twitterDescription && <meta name="twitter:description" content={resolvedSeo.twitterDescription} />}
    {resolvedSeo.twitterImage && <meta name="twitter:image" content={resolvedSeo.twitterImage} />}

    {pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {pageType === 'article' && (modifiedTime || publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime || publishedTime} />
    )}

    {resolvedSeo.jsonLd.map((schema, index) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} data-schema={String(index)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50 font-sans font-normal tracking-tight antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MBDTPXL3"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header messages={messages} locale={locale} navData={navData} siteSeo={siteSeo} />
    <main class="flex-1">
      <slot />
    </main>
    {shouldRenderGlobalCta && globalCtaData?.ctaTitle && (
      <HomeCta
        title={globalCtaData.ctaTitle}
        description={globalCtaData.ctaDescription}
        primaryLabel={t(messages, 'dealer.headerCta')}
        primaryHref={toHref(globalCtaData.ctaPrimaryLink || '/contact', locale)}
        locale={locale}
      />
    )}
    <Footer messages={messages} locale={locale} navData={navData} />
    <BackToTop />
    <script is:inline>
      (function () {
        var w = window;

        function runWhenIdle(callback, delay) {
          w.setTimeout(function () {
            if (typeof w.requestIdleCallback === 'function') {
              w.requestIdleCallback(callback, { timeout: 2000 });
            } else {
              callback();
            }
          }, delay);
        }

        function loadGtm() {
          if (w.__glorisGtmLoaded) return;
          w.__glorisGtmLoaded = true;
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

          var firstScript = document.getElementsByTagName('script')[0];
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-MBDTPXL3';
          firstScript.parentNode.insertBefore(script, firstScript);
        }

        function loadTawk() {
          if (w.__glorisTawkLoaded) return;
          w.__glorisTawkLoaded = true;
          w.Tawk_API = w.Tawk_API || {};
          w.Tawk_LoadStart = new Date();

          var firstScript = document.getElementsByTagName('script')[0];
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://embed.tawk.to/69d745e76839171c36f07831/default';
          script.charset = 'UTF-8';
          script.setAttribute('crossorigin', '*');
          firstScript.parentNode.insertBefore(script, firstScript);
        }

        // Keep analytics and chat available, but let the first screen render first.
        runWhenIdle(loadGtm, 1200);
        runWhenIdle(loadTawk, 3000);
      })();
    </script>
  </body>
</html>
