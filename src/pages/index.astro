---
import { defaultLocale } from '@/i18n/config';
import { redirectToVisitorHome } from '@/i18n/visitorLocale';

// Static builds have no visitor request. Pages Functions handle / at the edge.
if (Astro.isPrerendered || (Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD')) {
  return Astro.redirect(`/${defaultLocale}/`, 302);
}
return redirectToVisitorHome(Astro.request, Astro.url);
---
