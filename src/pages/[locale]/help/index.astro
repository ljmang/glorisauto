---
/**
 * 帮助中心首页：分类标签 + 按分类分组的 FAQ 列表
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { supportedLocales, type Locale, getLocale, localeLanguageTag } from '@/i18n/config';
import { loadMessages, t } from '@/i18n';
import { fetchApi, api } from '@/utils/strapiApi';
import { toHref } from '@/utils/navigationData';
import { resolveCollectionPageCopy } from '@/utils/collectionPageCopy';
import { fetchSiteSeo } from '@/utils/siteConfig';
import { buildHelpSearchItems } from '@/utils/helpSearch';
import Breadcrumb from '@/components/Breadcrumb.astro';
import HelpSearch from '@/components/HelpSearch.svelte';
import type { HelpCategoryAttributes, HelpCenterAttributes } from '@/types/content';

export async function getStaticPaths() {
  return supportedLocales.map((locale: Locale) => ({
    params: { locale },
  }));
}

const params = Astro.params as { locale?: string };
const locale: Locale = getLocale(params.locale);
const messages = await loadMessages(locale);

const [categoriesRes, articlesRes, siteSeo] = await Promise.all([
  fetchApi<{ data?: HelpCategoryAttributes[] }>(api.helpCategories, {
    locale,
    pagination: { pageSize: 100 },
  }),
  fetchApi<{ data?: HelpCenterAttributes[] }>(api.helpCenters, {
    locale,
    populate: { help_category: true, related_products: true },
    pagination: { pageSize: 500 },
  }),
  fetchSiteSeo(locale),
]);

// 1. 获取所有分类（按 sort 排序）
const categories = (categoriesRes?.data ?? []).sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));

const articles = articlesRes?.data ?? [];
const helpSearchItems = buildHelpSearchItems(articles, locale);
const sortArticles = (a: HelpCenterAttributes, b: HelpCenterAttributes) => {
  const aSort = Number.isFinite(a.sort) ? (a.sort as number) : Number.MAX_SAFE_INTEGER;
  const bSort = Number.isFinite(b.sort) ? (b.sort as number) : Number.MAX_SAFE_INTEGER;
  return aSort - bSort || (a.title ?? '').localeCompare(b.title ?? '', localeLanguageTag[locale]);
};

// 3. 按分类分组文章
const articlesByCategory = new Map<string, HelpCenterAttributes[]>();
articles.forEach((article) => {
  const categorySlug = article.help_category?.slug ?? 'uncategorized';
  if (!articlesByCategory.has(categorySlug)) {
    articlesByCategory.set(categorySlug, []);
  }
  articlesByCategory.get(categorySlug)!.push(article);
});

const activeCategories = categories.filter((category) => {
  const slug = category.slug ?? '';
  return slug !== '' && (articlesByCategory.get(slug)?.length ?? 0) > 0;
});

const recommendedArticles = [...articles]
  .filter((article) => article.recommend)
  .sort(sortArticles);
const featuredArticles = (recommendedArticles.length > 0 ? recommendedArticles : [...articles].sort(sortArticles))
  .slice(0, 4);

const productHelpLinksMap = new Map<
  string,
  { name: string; href: string; articleTitle: string; categoryName: string }
>();

for (const article of [...articles].sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0))) {
  const articleCategorySlug = article.help_category?.slug ?? '';
  const articleCategoryName = article.help_category?.name ?? '';
  const articleSlug = article.slug ?? '';
  if (!articleCategorySlug || !articleSlug || !Array.isArray(article.related_products)) continue;

  const articleHref = toHref(`/help/${articleCategorySlug}/${articleSlug}`, locale);
  for (const product of article.related_products) {
    const productName = product?.name ?? '';
    const productSlug = product?.slug ?? productName;
    if (!productName || !productSlug || productHelpLinksMap.has(productSlug)) continue;

    productHelpLinksMap.set(productSlug, {
      name: productName,
      href: articleHref,
      articleTitle: article.title,
      categoryName: articleCategoryName,
    });
  }
}

const productHelpLinks = Array.from(productHelpLinksMap.values()).sort((a, b) =>
  a.name.localeCompare(b.name, localeLanguageTag[locale])
);

// 4. 每个分类内的文章按 sort 排序
articlesByCategory.forEach((items) => {
  items.sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));
});

const breadcrumbItems = [
  { label: t(messages, 'pageTitle.home'), href: '/' },
  { label: t(messages, 'footer.support.helpCenter') },
];
const pageTitle = t(messages, 'footer.support.helpCenter');
const pageCopy = resolveCollectionPageCopy(locale, 'help', siteSeo);
---

<BaseLayout
  title={pageCopy.seoTitle}
  description={pageCopy.seoDescription}
  pageType="collection"
  breadcrumbs={breadcrumbItems}
  messages={messages}
  locale={locale}
>
  <div class="container mx-auto px-4 py-8 lg:py-10">
    <Breadcrumb items={breadcrumbItems} locale={locale} />

    <div class="mb-8 max-w-4xl lg:mb-10">
      <h1 class="text-4xl font-black tracking-tight lg:text-5xl">{pageCopy.heading}</h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-gray-600 lg:text-lg lg:leading-8">
        {pageCopy.intro}
      </p>
    </div>

    <div class="mb-12" aria-label={t(messages, 'footer.support.helpCenter')}>
      <HelpSearch client:load items={helpSearchItems} locale={locale} messages={messages} />
    </div>

    {activeCategories.length > 0 && (
      <section class="mb-14" aria-labelledby="help-browse-by-need">
        <div class="mb-5 max-w-3xl">
          <h2 id="help-browse-by-need" class="text-2xl font-bold tracking-tight lg:text-3xl">
            {t(messages, 'helpCenter.browseByNeedTitle')}
          </h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">
            {t(messages, 'helpCenter.browseByNeedDescription')}
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {activeCategories.map((category) => {
            const categoryArticles = articlesByCategory.get(category.slug) ?? [];
            const categoryDescription = category.description ?? category.descrition;
            return (
              <a
                href={toHref(`/help/${category.slug}`, locale)}
                class="group flex min-h-52 flex-col rounded-2xl border border-gray-200 border-t-4 border-t-orange-400 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-md"
              >
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-lg font-bold text-gray-900 transition-colors group-hover:text-orange-500 lg:text-xl">
                    {category.name}
                  </h3>
                  <span class="shrink-0 pt-1 text-xs font-semibold text-orange-600">
                    {t(messages, 'helpCenter.articleCount', { count: String(categoryArticles.length) })}
                  </span>
                </div>
                {categoryDescription && (
                  <p class="mt-4 line-clamp-3 text-sm leading-6 text-gray-600">{categoryDescription}</p>
                )}
                <span class="mt-auto inline-flex pt-6 text-sm font-semibold text-cyan-600 transition-colors group-hover:text-orange-500">
                  {t(messages, 'helpCenter.viewAllArticles')} →
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {featuredArticles.length > 0 && (
      <section class="mb-14" aria-labelledby="help-featured-questions">
        <div class="mb-5 max-w-3xl">
          <h2 id="help-featured-questions" class="text-2xl font-bold tracking-tight lg:text-3xl">
            {t(messages, 'helpCenter.featuredTitle')}
          </h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">{t(messages, 'helpCenter.featuredDescription')}</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {featuredArticles.map((article) => {
            const articleCategorySlug = article.help_category?.slug ?? 'uncategorized';
            const articleHref = toHref(`/help/${articleCategorySlug}/${article.slug}`, locale);
            return (
              <a
                href={articleHref}
                class="group flex min-h-44 flex-col rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-md"
              >
                {article.help_category?.name && (
                  <div class="mb-3 text-xs font-semibold uppercase tracking-wide text-orange-600">
                    {article.help_category.name}
                  </div>
                )}
                <h3 class="text-lg font-semibold leading-7 text-gray-900 transition-colors group-hover:text-orange-500">
                  {article.title}
                </h3>
                {(article.quickAnswer || article.description) && (
                  <p class="mt-3 line-clamp-2 text-sm leading-6 text-gray-600">
                    {article.quickAnswer || article.description}
                  </p>
                )}
                <div class="mt-auto pt-5 text-sm font-semibold text-cyan-600 transition-colors group-hover:text-orange-500">
                  {t(messages, 'helpCenter.openArticle')}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {productHelpLinks.length > 0 && (
      <section class="mb-4 border-y border-gray-200 py-8" aria-labelledby="help-browse-by-product">
        <div class="mb-5 max-w-3xl">
          <h2 id="help-browse-by-product" class="text-2xl font-bold tracking-tight lg:text-3xl">
            {t(messages, 'helpCenter.browseByProductTitle')}
          </h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">{t(messages, 'helpCenter.browseByProductDescription')}</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {productHelpLinks.map((item) => (
            <a
              href={item.href}
              class="rounded-full border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:border-orange-300 hover:bg-orange-50 hover:text-orange-700"
            >
              {item.name}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
