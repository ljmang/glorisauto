---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import InsightFeaturedCard from '@/components/InsightFeaturedCard.astro';
import InsightSearch from '@/components/InsightSearch.svelte';
import InsightProductCategoryBrowser from '@/components/InsightProductCategoryBrowser.svelte';
import { supportedLocales, type Locale, getLocale, localeLanguageTag } from '@/i18n/config';
import { loadMessages, t } from '@/i18n';
import { fetchApiWithLocaleFallback, api } from '@/utils/strapiApi';
import { toHref } from '@/utils/navigationData';
import { resolveCollectionPageCopy } from '@/utils/collectionPageCopy';
import { fetchSiteSeo } from '@/utils/siteConfig';
import { buildInsightSearchItems } from '@/utils/insightSearch';
import type { InsightAttributes, InsightCategoryAttributes } from '@/types/content';
import { buildInsightProductCategoryOptions, buildInsightCardItems } from '@/utils/insightProductCategories';

export async function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const params = Astro.params as { locale?: string };
const locale: Locale = getLocale(params.locale);
const messages = await loadMessages(locale);

const [categoriesRes, insightsRes, siteSeo] = await Promise.all([
  fetchApiWithLocaleFallback<{ data?: InsightCategoryAttributes[] }>(api.insightCategories, {
    locale,
    pagination: { pageSize: 100 },
  }),
  fetchApiWithLocaleFallback<{ data?: InsightAttributes[] }>(api.insights, {
    locale,
    populate: {
      cover: true,
      insight_category: true,
      products: {
        populate: {
          category: {
            populate: {
              parent: true,
            },
          },
        },
      },
    },
    pagination: { pageSize: 100 },
  }),
  fetchSiteSeo(locale),
]);

const categories = (Array.isArray(categoriesRes?.data) ? categoriesRes.data : [])
  .filter((c) => c?.name != null)
  .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));
// 排序：优先按 sort 字段（与英文版一致的排名），未设置 sort 的排在最后
const insights = (Array.isArray(insightsRes?.data) ? insightsRes.data : [])
  .sort((a, b) => {
    const aSort = Number.isFinite(a.sort) ? (a.sort as number) : Number.MAX_SAFE_INTEGER;
    const bSort = Number.isFinite(b.sort) ? (b.sort as number) : Number.MAX_SAFE_INTEGER;
    return aSort - bSort || (a.title ?? '').localeCompare(b.title ?? '', localeLanguageTag[locale]);
  });
const insightSearchItems = buildInsightSearchItems(insights, locale);

const breadcrumbItems = [
  { label: t(messages, 'pageTitle.home'), href: '/' },
  { label: t(messages, 'footer.about.insights'), href: undefined },
];
const pageTitle = t(messages, 'footer.about.insights');
const allArticlesLabel = t(messages, 'insights.allArticles');
const pageCopy = resolveCollectionPageCopy(locale, 'insights', siteSeo);
const [featuredInsight, ...remainingInsights] = insights;
const productCategoryOptions = buildInsightProductCategoryOptions(remainingInsights, locale);
const cardItems = buildInsightCardItems(remainingInsights, locale);
const pageSize = 12;
const pageCount = Math.ceil(remainingInsights.length / pageSize);
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = Number.isFinite(requestedPage) && requestedPage > 0
  ? Math.min(pageCount || 1, requestedPage)
  : 1;
---

<BaseLayout
  title={pageCopy.seoTitle}
  description={pageCopy.seoDescription}
  pageType="collection"
  breadcrumbs={breadcrumbItems}
  messages={messages}
  locale={locale}
>
  <div class="mx-auto max-w-[1320px] px-4 py-8 lg:py-12">
    <Breadcrumb items={breadcrumbItems} locale={locale} />

    <main class="mb-16">
      <section class="grid items-stretch gap-8 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-12">
        <div class="flex flex-col justify-center py-2 lg:py-8">
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-orange-600">{pageTitle}</p>
          <h1 class="max-w-xl text-5xl font-black tracking-tight text-slate-950 lg:text-6xl">{pageCopy.heading}</h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600 lg:text-xl lg:leading-9">
            {pageCopy.intro}
          </p>
          <div class="mt-8">
            <InsightSearch client:load items={insightSearchItems} locale={locale} messages={messages} />
          </div>
        </div>

        {featuredInsight && <InsightFeaturedCard insight={featuredInsight} locale={locale} messages={messages} />}
      </section>

      <section class="mt-10 flex flex-col gap-5 border border-slate-200 bg-white p-5 lg:flex-row lg:items-center lg:p-6">
        <p class="shrink-0 text-base font-bold text-slate-900 lg:w-48">{t(messages, 'insights.browseByCategory')}</p>
        <nav aria-label={t(messages, 'insights.browseByCategory')} class="flex min-w-0 gap-2 overflow-x-auto pb-1">
          <a
            href={toHref('/about/insights', locale)}
            class="shrink-0 rounded-md border border-orange-500 bg-orange-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-orange-600"
          >
            {allArticlesLabel}
          </a>
          {categories.map((cat) => (
            <a
              href={toHref(`/about/insights/${cat.slug}`, locale)}
              class="shrink-0 rounded-md border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-orange-400 hover:text-orange-600"
            >
              {cat.name}
            </a>
          ))}
        </nav>
      </section>

      <section class="mt-12" aria-labelledby={`insights-list-${locale}`}>
        <InsightProductCategoryBrowser
          client:load
          options={productCategoryOptions}
          articles={cardItems}
          title={allArticlesLabel}
          filterLabel={t(messages, 'insights.productCategoryFilterLabel')}
          allLabel={t(messages, 'insights.all')}
          readMoreLabel={t(messages, 'common.readMore')}
          noCoverLabel={t(messages, 'insights.noCover')}
          noArticlesLabel={t(messages, 'insights.noArticles')}
          articleCountLabel={t(messages, 'insights.articleCount')}
          previousPageLabel={t(messages, 'insights.previousPage')}
          nextPageLabel={t(messages, 'insights.nextPage')}
          pageLabel={t(messages, 'insights.page')}
          pageSize={12}
        />
      </section>
    </div>
  </div>
</BaseLayout>
