---
/**
 * Insights 分类页：沿用 Insights 首页的主推文章、分类标签和 16:9 卡片网格布局。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import InsightFeaturedCard from '@/components/InsightFeaturedCard.astro';
import InsightGridCard from '@/components/InsightGridCard.astro';
import InsightPagination from '@/components/InsightPagination.astro';
import { supportedLocales, type Locale, getLocale } from '@/i18n/config';
import { loadMessages, t } from '@/i18n';
import { fetchApiWithLocaleFallback, api } from '@/utils/strapiApi';
import { toHref } from '@/utils/navigationData';
import type { InsightAttributes, InsightCategoryAttributes } from '@/types/content';

export async function getStaticPaths() {
  const paths: { params: { locale: string; category: string } }[] = [];
  for (const locale of supportedLocales) {
    const res = await fetchApiWithLocaleFallback<{ data?: InsightCategoryAttributes[] }>(api.insightCategories, {
      locale,
      pagination: { pageSize: 100 },
    });
    const list = Array.isArray(res?.data) ? res.data : [];
    for (const cat of list) {
      if (cat.slug) paths.push({ params: { locale, category: cat.slug } });
    }
  }
  return paths;
}

const params = Astro.params as { locale?: string; category?: string };
const locale: Locale = getLocale(params.locale);
const categorySlug = params.category ?? '';
const messages = await loadMessages(locale);

const categoriesRes = await fetchApiWithLocaleFallback<{ data?: InsightCategoryAttributes[] }>(api.insightCategories, {
  locale,
  populate: {
    seo: {
      populate: {
        metaImage: true,
        ogImage: true,
        twitterImage: true,
      },
    },
  },
  pagination: { pageSize: 100 },
});
const categories = (Array.isArray(categoriesRes?.data) ? categoriesRes.data : [])
  .filter((c) => c?.name != null)
  .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));
const currentCategory = categories.find((c) => c.slug === categorySlug);
const categoryName = currentCategory?.name ?? categorySlug;

const insightsRes = await fetchApiWithLocaleFallback<{ data?: InsightAttributes[] }>(api.insights, {
  locale,
  populate: { cover: true, insight_category: true },
  pagination: { pageSize: 100 },
  filters: { insight_category: { slug: { $eq: categorySlug } } },
});
const insights = (Array.isArray(insightsRes?.data) ? insightsRes.data : [])
  .sort((a, b) => {
    const dateA = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const dateB = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    return dateB - dateA;
  });

const breadcrumbItems = [
  { label: t(messages, 'pageTitle.home'), href: '/' },
  { label: t(messages, 'footer.about.insights'), href: '/about/insights' },
  { label: categoryName, href: undefined },
];
const allArticlesLabel = t(messages, 'insights.allArticles');
const [featuredInsight, ...remainingInsights] = insights;
const categoryIntro = currentCategory?.description || t(messages, 'insights.categoryIntro');
const pageSize = 12;
const pageCount = Math.ceil(remainingInsights.length / pageSize);
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = Number.isFinite(requestedPage) && requestedPage > 0
  ? Math.min(pageCount || 1, requestedPage)
  : 1;
---

<BaseLayout
  title={`${categoryName} - ${t(messages, 'footer.about.insights')}`}
  description={currentCategory?.description}
  seo={currentCategory?.seo}
  pageType="collection"
  breadcrumbs={breadcrumbItems}
  messages={messages}
  locale={locale}
>
  <div class="mx-auto max-w-[1320px] px-4 py-8 lg:py-12">
    <Breadcrumb items={breadcrumbItems} locale={locale} />

    <main class="mb-16">
      <section class="grid items-stretch gap-8 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-12">
        <div class="flex flex-col justify-center py-2 lg:py-8">
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-orange-600">{t(messages, 'footer.about.insights')}</p>
          <h1 class="max-w-xl text-5xl font-black tracking-tight text-slate-950 lg:text-6xl">{categoryName}</h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600 lg:text-xl lg:leading-9">{categoryIntro}</p>
          <form action={toHref('/search', locale)} method="get" class="relative mt-8 max-w-xl">
            <label for={`insights-category-search-${locale}`} class="sr-only">{t(messages, 'insights.searchArticles')}</label>
            <input
              id={`insights-category-search-${locale}`}
              name="q"
              type="search"
              placeholder={t(messages, 'insights.searchArticles')}
              class="h-14 w-full rounded-xl border border-slate-200 bg-white px-5 pr-14 text-base text-slate-900 outline-none transition focus:border-orange-400"
            />
            <button
              type="submit"
              aria-label={t(messages, 'insights.searchArticles')}
              class="absolute right-2 top-2 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-slate-900 text-white transition hover:bg-orange-600"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-none stroke-current stroke-2">
                <circle cx="11" cy="11" r="6" />
                <path d="m16 16 4 4" />
              </svg>
            </button>
          </form>
        </div>

        {featuredInsight && <InsightFeaturedCard insight={featuredInsight} locale={locale} messages={messages} />}
      </section>

      <section class="mt-10 flex flex-col gap-5 border border-slate-200 bg-white p-5 lg:flex-row lg:items-center lg:p-6">
        <p class="shrink-0 text-base font-bold text-slate-900 lg:w-48">{t(messages, 'insights.browseByCategory')}</p>
        <nav aria-label={t(messages, 'insights.browseByCategory')} class="flex min-w-0 gap-2 overflow-x-auto pb-1">
          <a
            href={toHref('/about/insights', locale)}
            class="shrink-0 rounded-md border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-orange-400 hover:text-orange-600"
          >
            {allArticlesLabel}
          </a>
          {categories.map((cat) => {
            const isActive = cat.slug === categorySlug;
            return (
              <a
                href={toHref(`/about/insights/${cat.slug}`, locale)}
                class={`shrink-0 rounded-md border px-4 py-2 text-sm font-semibold transition ${isActive ? 'border-orange-500 bg-orange-500 text-white hover:bg-orange-600' : 'border-slate-200 bg-white text-slate-700 hover:border-orange-400 hover:text-orange-600'}`}
              >
                {cat.name}
              </a>
            );
          })}
        </nav>
      </section>

      <section class="mt-12" aria-labelledby={`insights-category-list-${locale}`} data-insights-pagination-root>
        <div class="mb-6 flex items-end justify-between gap-4">
          <h2 id={`insights-category-list-${locale}`} class="text-3xl font-black tracking-tight text-slate-950 lg:text-4xl">
            {allArticlesLabel}
          </h2>
          {insights.length > 0 && <span class="text-sm font-medium text-slate-500">{insights.length} {t(messages, 'footer.about.insights')}</span>}
        </div>

        {remainingInsights.length > 0 ? (
          <div>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
            {remainingInsights.map((insight, index) => (
              <div data-insight-item data-page={Math.floor(index / pageSize) + 1} style={Math.floor(index / pageSize) + 1 === currentPage ? undefined : 'display: none;'}>
                <InsightGridCard insight={insight} locale={locale} messages={messages} />
              </div>
            ))}
            </div>
            <InsightPagination
              currentPage={currentPage}
              pageCount={pageCount}
              baseId={`insights-category-list-${locale}`}
              messages={messages}
            />
          </div>
        ) : !featuredInsight ? (
          <p class="border border-dashed border-slate-300 py-16 text-center text-slate-500">{t(messages, 'search.noResults')}</p>
        ) : null}
      </section>
    </main>
  </div>
</BaseLayout>
