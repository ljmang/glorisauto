---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BlocksRenderer from '@/components/BlocksRenderer.astro';
import InsightCard from '@/components/InsightCard.astro';
import ProductCard from '@/components/ProductCard.astro';
import { supportedLocales, type Locale, getLocale } from '@/i18n/config';
import { loadMessages, t } from '@/i18n';
import { fetchApiWithLocaleFallback, api, parseHeroMedia, parseImage, parseImages, getStrapiUrl, resolveLocalizedImageAltText } from '@/utils/strapiApi';
import { toHref } from '@/utils/navigationData';
import { fetchSiteSeo } from '@/utils/siteConfig';
import { getSiteContactInfo } from '@/utils/siteContact';
import { renderDealerIntroHtml } from '@/utils/dealerIntroContent';
import type { BecomeDealerAttributes, InsightAttributes, ProductAttributes } from '@/types/content';
import type { StrapiResponse } from '@/types';
import { Image } from 'astro:assets';
import { extractTextFromBlocks } from '@/utils/blocks';
import { ArrowLeft, ArrowRight, ChevronDown, CircleChevronRight, MessageCircle, Phone, Mail, MapPin, Sparkles, Wrench, TrendingUp } from 'lucide-svelte';
import { countryOptions, getCountryLabel } from '@/data/countries';

export async function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const params = Astro.params as { locale?: string };
const locale: Locale = getLocale(params.locale);
const messages = await loadMessages(locale);

function resolveSectionHref(rawHref: string | null | undefined, fallbackHref: string): string {
  const href = rawHref?.trim();
  if (!href) return fallbackHref;
  if (href.startsWith('#')) return href;
  if (/^(https?:)?\/\//i.test(href)) return href;
  return toHref(href.startsWith('/') ? href : `/${href}`, locale);
}

async function fetchBecomeDealerContent() {
  const basePopulate = {
    heroMedia: true,
    seo: {
      populate: {
        metaImage: true,
        ogImage: true,
        twitterImage: true,
      },
    },
    introMedia: true,
    supportGroups: { populate: { items: { populate: { gallery: true } } } },
    partnerProfile: { populate: { targetItems: true, idealItems: true } },
    focus: { populate: { cover: true } },
    supportItems: { populate: { icon: true } },
    processSteps: { populate: { cover: true } },
    faqItems: { populate: '*' },
    products: { populate: { cover: true, images: true, category: true } },
  };

  try {
    return await fetchApiWithLocaleFallback<StrapiResponse<BecomeDealerAttributes>>(api.becomeDealer, {
      locale,
      populate: {
        ...basePopulate,
        articles: { populate: { cover: true, insight_category: true } },
      },
    });
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    if (!/Invalid key articles/i.test(message)) throw error;

    return fetchApiWithLocaleFallback<StrapiResponse<BecomeDealerAttributes & { insights?: (InsightAttributes & { cover?: unknown })[] }>>(api.becomeDealer, {
      locale,
      populate: {
        ...basePopulate,
        insights: { populate: { cover: true, insight_category: true } },
      },
    });
  }
}

const [dealerRes, siteSeo] = await Promise.all([fetchBecomeDealerContent(), fetchSiteSeo(locale)]);

const dealer = dealerRes?.data ?? null;
const heroMedia = dealer ? parseHeroMedia(dealer.heroMedia) : null;
const introMedia = parseImage(dealer?.introMedia);
const focusItems = dealer?.focus ?? [];
const supportItems = dealer?.supportItems ?? [];
const supportGroups = dealer?.supportGroups ?? [];
const partnerProfile = dealer?.partnerProfile ?? null;
const processSteps = dealer?.processSteps ?? [];
const faqItems = (dealer?.faqItems ?? []).filter((item) => item.question?.trim());
const dealerSupportTitlePattern = /经销商|販売代理店|موزع|dealer|distribu/i;
function isDealerSupportGroup(title: string | null | undefined): boolean {
  return dealerSupportTitlePattern.test(title ?? '');
}
const orderedSupportGroups = [...supportGroups].sort(
  (first, second) => Number(isDealerSupportGroup(second.title)) - Number(isDealerSupportGroup(first.title))
);
const dealerProducts = (dealer?.products ?? []) as ProductAttributes[];
const advantageInsights = ((dealer?.articles ?? (dealer as (BecomeDealerAttributes & { insights?: (InsightAttributes & { cover?: unknown })[] }) | null)?.insights) ?? []) as (InsightAttributes & { cover?: unknown })[];
const focusFallbackIcons = [Sparkles, Wrench, TrendingUp];
const siteContact = getSiteContactInfo(siteSeo);
const dealerWhatsappLabel = siteContact.whatsappLabel || t(messages, 'dealer.whatsapp');
const dealerChatLabel = siteContact.chatLabel || t(messages, 'dealer.chatNow');
const dealerAddressTitle = siteContact.addressTitle || t(messages, 'contactInfo.address');
const dealerMapLinkLabel = siteContact.mapLinkLabel || t(messages, 'contactInfo.mapLink');
const productsSectionHref = resolveSectionHref(dealer?.productsLink, toHref('/products', locale));
const productsSectionLabel = dealer?.productsLinkLabel?.trim() || t(messages, 'common.allProducts');
const articlesSectionHref = resolveSectionHref(dealer?.articlesLink, toHref('/about/insights', locale));
const articlesSectionLabel = dealer?.articlesLinkLabel?.trim() || t(messages, 'insights.allArticles');
const articlesSectionTitle =
  dealer?.articlesTitle?.trim() || dealer?.advantagesTitle || t(messages, 'dealer.advantagesTitle');
const processSectionTitle = dealer?.processTitle?.trim() || 'Cooperation Process';
const heroTitle = dealer?.title ?? t(messages, 'footer.about.becomeDealer');
const mobileHeroTitle =
  (dealer as (BecomeDealerAttributes & { mobileHeroTitle?: string }) | null)?.mobileHeroTitle?.trim() ||
  (locale === 'zh-cn' ? '成为 Gloris 汽车修复产品 B2B 合作伙伴' : heroTitle);
const heroSubtitle = dealer?.heroSubtitle?.trim();
const heroPrimaryLabel = dealer?.heroPrimaryLabel?.trim() || t(messages, 'common.allProducts');
const heroPrimaryHref = resolveSectionHref(dealer?.heroPrimaryLink, toHref('/products', locale));
const dealerApplyLabel = t(messages, 'dealer.applyCta');
const heroSecondaryLabel = dealerApplyLabel;
const dealerFormHref = '#dealer-form';
const introProductLine = dealer?.introProductLine?.trim();
const supportScopeLabels: Record<Locale, string> = {
  en: 'Support includes:',
  'zh-cn': '支持范围：',
  ja: 'サポート内容：',
  ar: 'يشمل الدعم:',
  es: 'El soporte incluye:',
};
function stripSupportScopeLabel(value: string): string {
  return value
    .trim()
    .replace(/^(?:Support includes:|支持范围：|サポート内容：|يشمل الدعم：|يشمل الدعم:|El soporte incluye:)\s*/i, '');
}
const introBlocks = Array.isArray(dealer?.introContent) ? dealer.introContent : [];
const introLeadBlocks = introBlocks.slice(0, 1);
const introBodyBlocks = introBlocks.slice(1);
const dealerIntroHtml = await renderDealerIntroHtml(dealer?.introContent, dealer?.title, locale);
const introMediaAlt = resolveLocalizedImageAltText(
  locale,
  null,
  introMedia?.alt,
  dealer?.title || t(messages, 'footer.about.becomeDealer')
);

const breadcrumbItems = [
  { label: t(messages, 'pageTitle.home'), href: '/' },
  { label: t(messages, 'footer.about.title'), href: '/about' },
  { label: heroTitle, href: undefined },
];

/** Message 接口 type：成为代理商 / 客户服务 */
const MESSAGE_TYPE_DEALER = '成为代理商';
const formTexts = {
  configError: t(messages, 'form.submitConfigError'),
  submitting: t(messages, 'form.submitting'),
  submitFailed: t(messages, 'form.submitFailed'),
  submit: t(messages, 'common.submit'),
};

/** 表单提交用的 API 基地址（服务端计算，避免客户端用 import.meta） */
const formApiBase = (() => {
  try {
    return getStrapiUrl();
  } catch {
    return '';
  }
})();
---

<BaseLayout
  title={heroTitle}
  description={dealer?.joinUsTitle}
  image={dealer?.heroMedia}
  seo={dealer?.seo}
  pageType="about"
  breadcrumbs={breadcrumbItems}
  messages={messages}
  locale={locale}
  siteSeo={siteSeo}
>
  <div class="dealer-page-shell mx-auto w-full px-4 pb-16 sm:px-6 lg:px-10 lg:pb-24">
    <div class="dealer-breadcrumb pt-4 pb-2">
      <Breadcrumb items={breadcrumbItems} locale={locale} />
    </div>

    <!-- 首屏：保留品牌大图，新增标题、副标题和橙色强调线 -->
    {heroMedia && heroMedia.src && (
      <section class="dealer-hero">
        {heroMedia.type === 'video' ? (
          <video
            class="dealer-hero-media"
            src={heroMedia.src}
            poster={heroMedia.poster}
            autoplay
            muted
            loop
            playsinline
            aria-label={heroTitle}
          />
        ) : (
          <Image
            src={heroMedia.src}
            alt={heroTitle}
            width={1920}
            height={780}
            class="dealer-hero-media"
            format="webp"
            quality={100}
            loading="eager"
          />
        )}
        <div class="dealer-hero-overlay" />
        <div class="dealer-hero-content">
          <div class="dealer-hero-copy">
            <h1>
              <span class="dealer-hero-title-desktop">{heroTitle}</span>
              <span class="dealer-hero-title-mobile">{mobileHeroTitle}</span>
            </h1>
            {heroSubtitle && <p>{heroSubtitle}</p>}
          </div>
        </div>
      </section>
    )}

    <!-- 产品图 + 介绍区：移动端图在上，桌面端图文并置 -->
    {(dealer?.introContent?.length || introMedia?.src || introProductLine) && (
      <section class="dealer-section dealer-intro">
        {introMedia?.src && (
          <div class="dealer-intro-media">
            <Image
              src={introMedia.src}
              alt={introMediaAlt}
              width={introMedia.width ?? 800}
              height={introMedia.height ?? 560}
              class="dealer-intro-image"
              format="webp"
              quality={100}
            />
          </div>
        )}
        <div class="dealer-intro-copy">
          <div class="dealer-intro-richtext">
            {dealerIntroHtml ? (
              <div class="dealer-intro-content article-content prose max-w-none" set:html={dealerIntroHtml} />
            ) : (
              <>
                {introLeadBlocks.length > 0 && (
                  <BlocksRenderer blocks={introLeadBlocks} locale={locale} variant="dealer" class="dealer-intro-blocks" />
                )}
                {introProductLine && <p class="dealer-product-line">{introProductLine}</p>}
                {introBodyBlocks.length > 0 && (
                  <BlocksRenderer blocks={introBodyBlocks} locale={locale} variant="dealer" class="dealer-intro-blocks" />
                )}
              </>
            )}
          </div>
          {dealerIntroHtml && introProductLine && <p class="dealer-product-line">{introProductLine}</p>}
          <div class="dealer-cta-row">
            <a class="dealer-button dealer-button--outline" href={heroPrimaryHref}>
              {heroPrimaryLabel}
              <ArrowRight class="dealer-button-icon" aria-hidden="true" />
            </a>
            <a class="dealer-button dealer-button--solid" href={dealerFormHref}>
              {heroSecondaryLabel}
              <ArrowRight class="dealer-button-icon" aria-hidden="true" />
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- 合作支持区：新 CMS 分组优先，旧语言或旧数据仍保留兼容展示 -->
    {supportGroups.length > 0 ? (
      <section id="support" class="dealer-section dealer-support">
        <div class="dealer-support-groups">
          {orderedSupportGroups.map((group) => {
            const groupTitle = group.title?.replace(/[（(]\s*折叠效果\s*[）)]/g, '').replace(/\s{2,}/g, ' ').trim();
            const groupKind = isDealerSupportGroup(group.title) ? 'dealer' : 'wholesale';
            const defaultOpenIndex = (group.items?.length ?? 0) > 1 ? 1 : 0;
            return (
            <div class="dealer-support-group" data-support-group={groupKind}>
              {groupTitle && <h2 class="dealer-section-title">{groupTitle}</h2>}
              <div class="dealer-accordion" data-dealer-accordion>
                {(group.items ?? []).map((item, itemIndex) => {
                  const description = extractTextFromBlocks(item.description, 1000);
                  const galleryImages = parseImages(item.gallery);
                  return (
                    <details class="dealer-accordion-item" open={itemIndex === defaultOpenIndex}>
                      <summary class="dealer-accordion-summary">
                        <span>{item.title}</span>
                        <ChevronDown class="dealer-accordion-icon" aria-hidden="true" />
                      </summary>
                      <div class="dealer-accordion-panel">
                        {item.subtitle && <h3 class="dealer-support-subtitle">{item.subtitle}</h3>}
                        {description && <p class="dealer-support-description">{description}</p>}
                        {item.supportScope && (
                          <p class="dealer-support-scope">
                            <strong>{supportScopeLabels[locale]}</strong>
                            {stripSupportScopeLabel(item.supportScope)}
                          </p>
                        )}
                        {galleryImages.length > 0 && (
                          <div class="dealer-gallery" data-dealer-gallery>
                            <div class="dealer-gallery-stage">
                              <div class="dealer-gallery-track" data-dealer-gallery-track>
                                {galleryImages.map((galleryImage, galleryIndex) => (
                                  <div class="dealer-gallery-slide" data-dealer-gallery-slide>
                                    <Image
                                      src={galleryImage.src}
                                      alt={resolveLocalizedImageAltText(locale, null, galleryImage.alt, item.title || heroTitle)}
                                      width={galleryImage.width ?? 1200}
                                      height={galleryImage.height ?? 800}
                                      class="dealer-gallery-image"
                                      format="webp"
                                      quality={100}
                                      loading="lazy"
                                    />
                                  </div>
                                ))}
                              </div>
                              {galleryImages.length > 1 && (
                                <div class="dealer-gallery-switcher" aria-label={locale === 'zh-cn' ? '切换合作支持图片' : 'Change support image'}>
                                  <button
                                    type="button"
                                    class="dealer-gallery-arrow"
                                    data-dealer-gallery-prev
                                    aria-label={locale === 'zh-cn' ? '上一张图片' : 'Previous image'}
                                  >
                                    <ArrowLeft class="dealer-gallery-arrow-icon" aria-hidden="true" />
                                  </button>
                                  <button
                                    type="button"
                                    class="dealer-gallery-arrow"
                                    data-dealer-gallery-next
                                    aria-label={locale === 'zh-cn' ? '下一张图片' : 'Next image'}
                                  >
                                    <ArrowRight class="dealer-gallery-arrow-icon" aria-hidden="true" />
                                  </button>
                                </div>
                              )}
                            </div>
                            {galleryImages.length > 1 && (
                              <div class="dealer-gallery-dots" role="tablist" aria-label={locale === 'zh-cn' ? '合作支持图片' : 'Support images'}>
                                {galleryImages.map((_, galleryIndex) => (
                                  <button
                                    type="button"
                                    class:list={["dealer-gallery-dot", galleryIndex === 0 && "is-active"]}
                                    data-dealer-gallery-dot
                                    data-slide-index={galleryIndex}
                                    aria-label={`${locale === 'zh-cn' ? '图片' : 'Image'} ${galleryIndex + 1}`}
                                  />
                                ))}
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    </details>
                  );
                })}
              </div>
            </div>
            );
          })}
        </div>
      </section>
    ) : (
      (supportItems.length > 0 || focusItems.length > 0) && (
        <section id="support" class="dealer-section dealer-support dealer-support--legacy">
          <h2 class="dealer-section-title">{dealer?.supportTitle || dealer?.advantagesTitle || t(messages, 'dealer.advantagesTitle')}</h2>
          <div class="dealer-legacy-grid">
            {(supportItems.length > 0 ? supportItems : focusItems.slice(0, 3)).map((item, index) => {
              const iconImage = 'icon' in item ? parseImage(item.icon) : parseImage(item.cover);
              const iconAlt = resolveLocalizedImageAltText(locale, null, iconImage?.alt, item.title || '');
              const subtitle = 'description' in item ? item.description : extractTextFromBlocks(item.content, 120);
              const FallbackIcon = focusFallbackIcons[index] ?? Sparkles;
              return (
                <div class="dealer-legacy-card">
                  {iconImage?.src ? (
                    <Image src={iconImage.src} alt={iconAlt} width={iconImage.width ?? 96} height={iconImage.height ?? 96} class="dealer-legacy-icon" format="webp" quality={100} />
                  ) : (
                    <FallbackIcon class="dealer-legacy-icon dealer-legacy-icon--fallback" aria-hidden="true" />
                  )}
                  {item.title && <h3>{item.title}</h3>}
                  {subtitle && <p>{subtitle}</p>}
                </div>
              );
            })}
          </div>
        </section>
      )
    )}

    <!-- 合作伙伴画像 + 合作流程：桌面端并排，移动端顺序堆叠 -->
    {(partnerProfile || processSteps.length > 0) && (
      <div class="dealer-section dealer-partner-process">
      {partnerProfile && (
      <section id="partner" class="dealer-partner">
        <div class="dealer-section-heading dealer-section-heading--wide">
          {partnerProfile.title && <h2 class="dealer-section-title">{partnerProfile.title}</h2>}
          {extractTextFromBlocks(partnerProfile.description, 1000) && (
            <p class="dealer-section-lede">{extractTextFromBlocks(partnerProfile.description, 1000)}</p>
          )}
        </div>
        <div class="dealer-partner-columns">
          <div>
            {partnerProfile.targetTitle && <h3 class="dealer-list-title">{partnerProfile.targetTitle}</h3>}
            <ul class="dealer-list">
              {(partnerProfile.targetItems ?? []).map((item) => item.text && <li>{item.text}</li>)}
            </ul>
          </div>
          <div>
            {partnerProfile.idealTitle && <h3 class="dealer-list-title">{partnerProfile.idealTitle}</h3>}
            <ul class="dealer-list">
              {(partnerProfile.idealItems ?? []).map((item) => item.text && <li>{item.text}</li>)}
            </ul>
          </div>
        </div>
        {partnerProfile.ctaLabel && (
          <a class="dealer-button dealer-button--solid" href={dealerFormHref}>
            {dealerApplyLabel}
            <ArrowRight class="dealer-button-icon" aria-hidden="true" />
          </a>
        )}
      </section>
    )}

    {processSteps.length > 0 && (
      <section id="process" class="dealer-process">
        <div class="dealer-section-heading dealer-section-heading--wide">
          <h2 class="dealer-section-title">{processSectionTitle}</h2>
        </div>
        <ol class="dealer-process-list">
          {processSteps.map((step, index) => {
            const stepText = locale === 'zh-cn' ? `第 ${index + 1} 步` : step.stepLabel?.trim() || `Step ${index + 1}`;
            return (
              <li class="dealer-process-step">
                <div class="dealer-process-heading">
                  <span class="dealer-process-number">{stepText}</span>
                  {step.title && <h3>{step.title}</h3>}
                </div>
                {step.description && <p>{step.description}</p>}
              </li>
            );
          })}
        </ol>
      </section>
    )}
    </div>
    )}

    {faqItems.length > 0 && (
      <section id="faq" class="dealer-section dealer-faq">
        <div class="dealer-section-heading dealer-section-heading--wide">
          <h2 class="dealer-section-title">{dealer?.faqTitle?.trim() || 'FAQ'}</h2>
        </div>
        <div class="dealer-faq-list dealer-accordion" data-dealer-accordion>
          {faqItems.map((faq, index) => (
            <details class="dealer-accordion-item" open={index === 0}>
              <summary class="dealer-accordion-summary">
                <span>{faq.question}</span>
                <ChevronDown class="dealer-accordion-icon" aria-hidden="true" />
              </summary>
              <div class="dealer-accordion-panel">
                {Array.isArray(faq.answer) && faq.answer.length > 0 && (
                  <BlocksRenderer
                    blocks={faq.answer}
                    locale={locale}
                    variant="dealer"
                    class="dealer-faq-answer"
                  />
                )}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Join Us Now：表单 + 客服信息 -->
    <section class="dealer-existing-section dealer-join-section mt-24 mb-16 lg:mt-32 lg:mb-20">
      <h2 class="dealer-join-title mb-8 text-3xl font-black text-slate-950 lg:mb-10 lg:text-4xl">
        {dealer?.joinUsTitle ?? t(messages, 'dealer.joinUsTitle')}
      </h2>
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-5 lg:gap-12">
      <div class="lg:col-span-3">
        <form
          id="dealer-form"
          class="space-y-4"
          data-thank-you={toHref('/thank-you', locale)}
          data-type={MESSAGE_TYPE_DEALER}
          data-api-base={formApiBase}
        >
          <div>
            <label for="dealer-name" class="block text-sm font-medium text-gray-700 mb-1">
              {dealer?.yourName ?? t(messages, 'form.name')} *
            </label>
            <input
              type="text"
              id="dealer-name"
              name="name"
              required
              class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
              placeholder={t(messages, 'form.namePlaceholder')}
            />
          </div>
          <div>
            <label for="dealer-email" class="block text-sm font-medium text-gray-700 mb-1">
              {dealer?.yourEmail ?? t(messages, 'form.email')} *
            </label>
            <input
              type="email"
              id="dealer-email"
              name="email"
              required
              class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
              placeholder={t(messages, 'form.emailPlaceholder')}
            />
          </div>
          <div>
            <label for="dealer-country" class="block text-sm font-medium text-gray-700 mb-1">
              {dealer?.country ?? t(messages, 'form.country')} *
            </label>
            <select
              id="dealer-country"
              name="country"
              required
              class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
            >
              <option value="">{t(messages, 'form.countryPlaceholder')}</option>
              {countryOptions.map((opt) => (
                <option value={opt.value}>{getCountryLabel(opt, locale)}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="dealer-phone" class="block text-sm font-medium text-gray-700 mb-1">
              {dealer?.yourPhone ?? t(messages, 'form.phone')} *
            </label>
            <input
              type="tel"
              id="dealer-phone"
              name="phone"
              required
              class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
              placeholder={t(messages, 'form.phonePlaceholder')}
            />
          </div>
          <div>
            <label for="dealer-message" class="block text-sm font-medium text-gray-700 mb-1">
              {dealer?.message ?? t(messages, 'form.message')} *
            </label>
            <textarea
              id="dealer-message"
              name="message"
              required
              rows={5}
              class="w-full resize-y rounded-md border border-slate-300 bg-white px-4 py-3 focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
              placeholder={t(messages, 'form.messagePlaceholder')}
            />
          </div>
          <button
            type="submit"
            id="dealer-submit"
            class="w-full rounded-md bg-orange-500 px-8 py-3 font-semibold text-white transition-colors hover:bg-orange-600 disabled:opacity-50"
          >
            {t(messages, 'common.submit')}
          </button>
        </form>
      </div>
      <div class="lg:col-span-2 lg:pt-5">
        <div class="rounded-2xl bg-white p-6">
        <h3 class="mb-4 text-xl font-bold text-slate-950">
          {dealer?.customerServiceTitle ?? t(messages, 'dealer.customerServiceTitle')}
        </h3>
        {siteContact.phone && (
          <p class="mb-2 flex items-center gap-2 text-slate-700">
            <Phone class="w-5 h-5 text-orange-500 shrink-0" />
            <a href={siteContact.phoneHref} class="hover:text-orange-600">
              {siteContact.phone}
            </a>
          </p>
        )}
        {siteContact.email && (
