    .dealer-process-step p {
      font-size: 0.95rem;
    }

    .dealer-support-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5rem;
    }

    .dealer-partner-process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5rem;
    }

    .dealer-hero-copy p {
      display: block;
      margin-top: 1rem;
      font-size: clamp(1rem, 1.55vw, 1.35rem);
    }

    .dealer-hero-title-desktop {
      display: inline;
    }

    .dealer-hero-title-mobile {
      display: none;
    }

    .dealer-hero-copy {
      max-width: 62rem;
      padding-inline-start: 0;
      border-inline-start: 0;
      text-align: center;
    }

    .dealer-partner-columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .dealer-process-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .dealer-process-step {
      min-height: 0;
      padding-inline-start: 1rem;
    }

    .dealer-process-number {
      font-size: 1rem;
    }

    .dealer-process-step h3 {
      font-size: 1.125rem;
    }

    .dealer-process-step p {
      margin-top: 0.4rem;
      font-size: 1.05rem;
    }

    .dealer-faq-answer {
      font-size: 1.05rem;
    }

    .dealer-legacy-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .dealer-gallery-track {
      overflow-x: auto;
      touch-action: pan-y;
      user-select: none;
      cursor: grab;
    }

    .dealer-gallery-track.is-dragging {
      cursor: grabbing;
      scroll-behavior: auto;
      scroll-snap-type: none;
    }
  }

  @media (max-width: 639px) {
    .dealer-breadcrumb {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dealer-button,
    .dealer-inline-cta,
    .dealer-accordion-icon,
    .dealer-gallery-arrow,
    .dealer-gallery-track {
      transition: none;
      scroll-behavior: auto;
    }
  }
</style>

<script define:vars={{ locale, formTexts }}>
  (function () {
    document.querySelectorAll('[data-dealer-accordion]').forEach((accordion) => {
      const items = Array.from(accordion.querySelectorAll('details'));
      const mobileQuery = window.matchMedia('(max-width: 767px)');

      const syncMobileAccordionState = () => {
        if (!mobileQuery.matches) return;
        items.forEach((item) => {
          item.open = false;
        });
      };

      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          items.forEach((other) => {
            if (other !== item) other.open = false;
          });
        });
      });

      syncMobileAccordionState();
      mobileQuery.addEventListener?.('change', syncMobileAccordionState);
    });

    document.querySelectorAll('[data-dealer-gallery]').forEach((gallery) => {
      const track = gallery.querySelector('[data-dealer-gallery-track]');
      const slides = Array.from(gallery.querySelectorAll('[data-dealer-gallery-slide]'));
      const dots = Array.from(gallery.querySelectorAll('[data-dealer-gallery-dot]'));
      const previousButton = gallery.querySelector('[data-dealer-gallery-prev]');
      const nextButton = gallery.querySelector('[data-dealer-gallery-next]');
      if (!track || slides.length < 2 || dots.length === 0) return;
      const details = gallery.closest('details');
      const mobileQuery = window.matchMedia('(max-width: 767px)');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const autoplayDelay = 5000;
      let activeIndex = 0;
      let autoplayTimer = null;
      let resumeTimer = null;
      let pointerId = null;
      let pointerStartX = 0;
      let pointerStartScrollLeft = 0;
      let isDragging = false;

      const getClosestIndex = () => slides.reduce((closestIndex, slide, index) => {
          const currentDistance = Math.abs(slide.offsetLeft - track.scrollLeft);
          const closestDistance = Math.abs(slides[closestIndex].offsetLeft - track.scrollLeft);
          return currentDistance < closestDistance ? index : closestIndex;
        }, 0);

      const updateActiveDot = () => {
        activeIndex = getClosestIndex();
        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          if (isActive) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      const isGalleryOpen = () => !details || details.open;

      const stopAutoplay = () => {
        if (autoplayTimer !== null) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (prefersReducedMotion.matches || document.hidden || !isGalleryOpen()) return;
        autoplayTimer = window.setInterval(() => {
          if (document.hidden || !isGalleryOpen()) {
            stopAutoplay();
            return;
          }
          goToSlide(activeIndex + 1);
        }, autoplayDelay);
      };

      const scheduleAutoplayResume = () => {
        if (resumeTimer !== null) window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(startAutoplay, autoplayDelay);
      };

      const goToSlide = (index) => {
        activeIndex = (index + slides.length) % slides.length;
        track.scrollTo({
          left: slides[activeIndex].offsetLeft,
          behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
        });
        updateActiveDot();
      };

      const navigate = (index) => {
        stopAutoplay();
        goToSlide(index);
        scheduleAutoplayResume();
      };

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => navigate(index));
      });

      previousButton?.addEventListener('click', () => navigate(activeIndex - 1));
      nextButton?.addEventListener('click', () => navigate(activeIndex + 1));

      track.addEventListener('scroll', updateActiveDot, { passive: true });

      track.addEventListener('pointerdown', (event) => {
        if (!mobileQuery.matches) return;
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        pointerId = event.pointerId;
        pointerStartX = event.clientX;
        pointerStartScrollLeft = track.scrollLeft;
        isDragging = false;
        stopAutoplay();
        track.setPointerCapture?.(event.pointerId);
      });

      track.addEventListener('pointermove', (event) => {
        if (!mobileQuery.matches || pointerId !== event.pointerId) return;
        const delta = event.clientX - pointerStartX;
        if (Math.abs(delta) > 6) {
          isDragging = true;
          event.preventDefault();
          track.scrollLeft = pointerStartScrollLeft - delta;
        }
      });

      const endPointerDrag = (event) => {
        if (pointerId !== event.pointerId) return;
        if (track.hasPointerCapture?.(event.pointerId)) track.releasePointerCapture(event.pointerId);
        pointerId = null;
        track.classList.remove('is-dragging');
        if (isDragging) goToSlide(getClosestIndex());
        isDragging = false;
        scheduleAutoplayResume();
      };

      track.addEventListener('pointerup', endPointerDrag);
      track.addEventListener('pointercancel', endPointerDrag);
      track.addEventListener('pointerleave', (event) => {
        if (mobileQuery.matches && pointerId === event.pointerId) endPointerDrag(event);
      });
      track.addEventListener('pointerdown', () => {
        if (mobileQuery.matches) track.classList.add('is-dragging');
      });
      track.addEventListener('mouseenter', stopAutoplay);
      track.addEventListener('mouseleave', startAutoplay);
      track.addEventListener('focusin', stopAutoplay);
      track.addEventListener('focusout', () => {
        if (!gallery.contains(document.activeElement)) scheduleAutoplayResume();
      });

      details?.addEventListener('toggle', () => {
        if (!details.open) {
          stopAutoplay();
          return;
        }
        window.requestAnimationFrame(() => {
          updateActiveDot();
          startAutoplay();
        });
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });
      mobileQuery.addEventListener?.('change', () => {
        if (!mobileQuery.matches) {
          pointerId = null;
          isDragging = false;
          track.classList.remove('is-dragging');
        }
        updateActiveDot();
      });
      prefersReducedMotion.addEventListener?.('change', startAutoplay);
      updateActiveDot();
      startAutoplay();
    });
  })();

  (function () {
    const form = document.getElementById('dealer-form');
    if (!form) return;

    const thankYouUrl = form.getAttribute('data-thank-you') || `/${locale}/thank-you`;
    const messageType = form.getAttribute('data-type') || '成为代理商';
    const base = form.getAttribute('data-api-base') || '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = form.querySelector('[name="name"]')?.value?.trim();
      const email = form.querySelector('[name="email"]')?.value?.trim();
      const country = form.querySelector('[name="country"]')?.value?.trim();
      const phone = form.querySelector('[name="phone"]')?.value?.trim();
      const message = form.querySelector('[name="message"]')?.value?.trim();

      if (!name || !email || !country || !phone || !message) return;
      if (!base) {
        alert(formTexts.configError);
        return;
      }

      const btn = document.getElementById('dealer-submit');
      if (btn) {
        btn.disabled = true;
        btn.textContent = formTexts.submitting;
      }

      try {
        const res = await fetch(`${base}/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            data: {
              type: messageType,
              name,
              email,
              country,
              phone,
              message,
            },
          }),
        });

        if (res.ok) {
          window.location.href = thankYouUrl;
          return;
        }
        const err = await res.json().catch(() => ({}));
        const rawMsg = err?.error?.message;
        let errorMsg = formTexts.submitFailed;
        if (locale === 'en' && rawMsg) {
          errorMsg = rawMsg;
        } else if (typeof rawMsg === 'string') {
          const lower = rawMsg.toLowerCase();
          if (lower.includes('email') && (lower.includes('valid') || lower.includes('format'))) {
            if (locale === 'zh-cn') errorMsg = '请输入有效的电子邮箱地址';
            else if (locale === 'es') errorMsg = 'Introduce una dirección de correo electrónico válida';
            else if (locale === 'ja') errorMsg = '有効なメールアドレスを入力してください';
            else if (locale === 'ar') errorMsg = 'يرجى إدخال عنوان بريد إلكتروني صالح';
          } else if (lower.includes('required')) {
            if (locale === 'zh-cn') errorMsg = '请填写所有必填项';
            else if (locale === 'es') errorMsg = 'Por favor, completa todos los campos obligatorios';
            else if (locale === 'ja') errorMsg = '必須項目をすべて入力してください';
            else if (locale === 'ar') errorMsg = 'يرجى ملء جميع الحقول المطلوبة';
          }
        }
        alert(errorMsg);
      } catch (_) {
        alert(formTexts.submitFailed);
      } finally {
        const btn = document.getElementById('dealer-submit');
        if (btn) {
          btn.disabled = false;
          btn.textContent = formTexts.submit;
        }
      }
    });
  })();
</script>
