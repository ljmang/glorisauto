---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { supportedLocales, type Locale, getLocale } from '@/i18n/config';
import { loadMessages, t } from '@/i18n';
import { fetchApi, api, parseImage, parseMediaItems, getMediaUrl } from '@/utils/strapiApi';
import { toHref } from '@/utils/navigationData';
import { markdownToHtml } from '@/utils/markdown';
import { hasMeaningfulText, sanitizeInlineText, sanitizeMarkdown } from '@/utils/contentSanitizers';
import type { BlockNode } from '@/types/blocks';
import BlocksRenderer from '@/components/BlocksRenderer.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ProductGallery from '@/components/ProductGallery.astro';
import DownloadFileCard from '@/components/DownloadFileCard.astro';
import InsightCard from '@/components/InsightCard.astro';
import { CircleChevronRight, MessageCircle } from 'lucide-svelte';
import type { HelpCenterAttributes, InsightAttributes, ProductAttributes } from '@/types/content';

export async function getStaticPaths() {
  const paths: { params: { locale: string; category: string; slug: string } }[] = [];
  for (const locale of supportedLocales) {
    const res = await fetchApi<{ data?: (ProductAttributes & { category?: { slug?: string } })[] }>(api.products, {
      locale,
      populate: { cover: true, images: true, category: true },
      pagination: { pageSize: 500 },
    });
    const list = Array.isArray(res?.data) ? res.data : [];
    for (const product of list) {
      const slug = product.slug;
      const categorySlug =
        product.category && typeof product.category === 'object' && 'slug' in product.category
          ? (product.category as { slug?: string }).slug
          : '';
      if (slug && categorySlug) {
        paths.push({ params: { locale, category: categorySlug, slug } });
      }
    }
  }
  return paths;
}

const params = Astro.params as { locale?: string; category?: string; slug?: string };
const locale: Locale = getLocale(params.locale);
const categorySlug = params.category ?? '';
const productSlug = params.slug ?? '';
const messages = await loadMessages(locale);

type ProductResponse = { data?: ProductAttributes[] };

const productBasePopulate = {
  images: true,
  cover: true,
  category: true,
  seo: {
    populate: {
      metaImage: true,
      ogImage: true,
      twitterImage: true,
    },
  },
  information: true,
  technicalDetails: true,
  options: true,
  hole: true,
  downloadFiles: { populate: { file: true } },
  help_centers: { populate: { help_category: true } },
  insights: { populate: { cover: true, insight_category: true } },
};

const productFilters = {
  slug: { $eq: productSlug },
  category: { slug: { $eq: categorySlug } },
};

const productsRes = await fetchApi<ProductResponse>(api.products, {
  locale,
  populate: productBasePopulate,
  filters: productFilters,
  pagination: { pageSize: 1 },
});

const product = Array.isArray(productsRes?.data) && productsRes.data.length > 0 ? productsRes.data[0] : null;
const category = (product as { category?: { slug?: string; name?: string } } | null)?.category;
const categoryName = category?.name ?? categorySlug;

const productCoverImage = product ? parseImage(product.cover) : null;
const productMedia = product ? parseMediaItems(product.images) : [];
const productGalleryMedia =
  productMedia.length > 0
    ? productMedia.map((media) =>
        media.type === 'video' && !media.poster && productCoverImage?.src
          ? { ...media, poster: productCoverImage.src }
          : media
      )
    : productCoverImage
      ? [{ type: 'image' as const, ...productCoverImage }]
      : [];
const productSeoImage = productCoverImage ?? productGalleryMedia.find((media) => media.type === 'image') ?? null;
const rawInformationList = (product as { information?: { title?: string; description?: BlockNode[] }[] } | null)?.information ?? [];
const informationList = rawInformationList
  .map((item) => ({
    title: sanitizeInlineText(item?.title ?? ''),
    description: item?.description ?? [],
  }))
  .filter((item) => item.title || item.description.length > 0);
const rawTechnicalDetailsList =
  (product as { technicalDetails?: { title?: string; description?: string }[] } | null)?.technicalDetails ?? [];
const technicalDetailsList = rawTechnicalDetailsList
  .map((item) => ({
    title: sanitizeInlineText(item?.title ?? ''),
    description: sanitizeInlineText(item?.description ?? ''),
  }))
  .filter((item) => hasMeaningfulText(item.title) && hasMeaningfulText(item.description));
const optionsList = ((product as { options?: { name?: string }[] } | null)?.options ?? [])
  .map((item) => ({ name: sanitizeInlineText(item?.name ?? '') }))
  .filter((item) => item.name);
const holeList = ((product as { hole?: { name?: string }[] } | null)?.hole ?? [])
  .map((item) => ({ name: sanitizeInlineText(item?.name ?? '') }))
  .filter((item) => item.name);
const industryPainPointsMarkdown = sanitizeMarkdown(product?.industryPainPoints ?? '');
const industryPainPointsHtml = await markdownToHtml(industryPainPointsMarkdown, product?.name);
const productFeaturesMarkdown = sanitizeMarkdown(product?.productFeatures ?? '');
const productFeaturesHtml = await markdownToHtml(productFeaturesMarkdown, product?.name);
const productDescription = sanitizeInlineText(product?.description ?? '');

type DownloadFileEntry = {
  title?: string;
  description?: string;
  file?: { url?: string; name?: string; ext?: string; size?: number };
};
const rawDownloads = (product as { downloadFiles?: DownloadFileEntry[] } | null)?.downloadFiles ?? [];
const downloadFilesList = rawDownloads.map((d) => ({
  title: sanitizeInlineText(d?.title ?? ''),
  description: sanitizeInlineText(d?.description ?? ''),
  file: d?.file ? { ...d.file, url: d.file.url ? getMediaUrl(d.file.url) : undefined } : undefined,
}));

type ProductHelpCenterEntry = Partial<Pick<HelpCenterAttributes, 'title' | 'slug' | 'contentMarkdown'>> & {
  help_category?: { slug?: string } | null;
};

const relatedHelpCenters = Array.isArray((product as { help_centers?: ProductHelpCenterEntry[] } | null)?.help_centers)
  ? ((product as { help_centers?: ProductHelpCenterEntry[] }).help_centers ?? [])
  : [];

type ProductInsightEntry = InsightAttributes & {
  id?: string | number;
  documentId?: string;
  cover?: unknown;
};

const relatedInsights = Array.isArray((product as { insights?: ProductInsightEntry[] } | null)?.insights)
  ? ((product as { insights?: ProductInsightEntry[] }).insights ?? [])
  : [];
const relatedInsightItems: ProductInsightEntry[] = [];

function getInsightKey(insight: ProductInsightEntry): string {
  if (insight.documentId) return `document:${insight.documentId}`;
  if (insight.id != null) return `id:${insight.id}`;

  const category = insight.insight_category && typeof insight.insight_category === 'object' ? insight.insight_category : null;
  const categorySlug = category?.slug ?? '';
  if (insight.slug) return `slug:${categorySlug}:${insight.slug}`;

  return `title:${insight.title}`;
}

for (const insight of relatedInsights) {
  if (!insight?.slug || !insight?.title) continue;

  const key = getInsightKey(insight);
  const exists = relatedInsightItems.some((existingInsight) => getInsightKey(existingInsight) === key);
  if (!exists) relatedInsightItems.push(insight);
}

type HelpCenterItem = {
  title?: string;
  slug?: string;
  contentMarkdown?: string;
  contentHtml?: string;
  href?: string;
};

const faqItems: HelpCenterItem[] = [];

async function buildHelpCenterItem(entry: ProductHelpCenterEntry): Promise<HelpCenterItem | null> {
  const markdown = entry.contentMarkdown?.trim() ?? '';
  if (!markdown) return null;

  const catSlug = entry.help_category?.slug ?? '';
  const href = catSlug && entry.slug ? toHref(`/help/${catSlug}/${entry.slug}`, locale) : '';

  return {
    title: entry.title,
    slug: entry.slug,
    contentMarkdown: markdown,
    contentHtml: await markdownToHtml(markdown, entry.title),
    href,
  };
}

function getFaqItemKey(item: HelpCenterItem): string {
  return item.href || item.slug || item.title || item.contentMarkdown || '';
}

async function addFaqItem(entry: ProductHelpCenterEntry): Promise<void> {
  const item = await buildHelpCenterItem(entry);
  if (!item) return;

  const key = getFaqItemKey(item);
  const exists = faqItems.some((existingItem) => getFaqItemKey(existingItem) === key);
  if (!exists) faqItems.push(item);
}

for (const relatedHelpCenter of relatedHelpCenters) {
  await addFaqItem(relatedHelpCenter);
}

const isFilmMasterPage = categorySlug === 'film-sanding-disc' && productSlug === 'film-master-sanding-disc';
if (isFilmMasterPage) {
  const commonFaqRes = await fetchApi<{ data?: Array<{ title?: string; slug?: string; contentMarkdown?: string; help_category?: { slug?: string } }> }>(api.helpCenters, {
    locale,
    filters: { slug: { $eq: 'common-abrasive-backing-materials' } },
    populate: { help_category: true },
    pagination: { pageSize: 1 },
  });
  const commonFaq = Array.isArray(commonFaqRes?.data) && commonFaqRes.data.length > 0 ? commonFaqRes.data[0] : null;
  if (commonFaq) {
    await addFaqItem(commonFaq);
  }
}

type ProductSectionLink = {
  id: string;
  label: string;
  visible: boolean;
};

const productSectionLinks: ProductSectionLink[] = [
  { id: 'product-overview', label: t(messages, 'products.overview'), visible: true },
  { id: 'technical-details', label: t(messages, 'products.technicalDetails'), visible: technicalDetailsList.length > 0 },
  { id: 'industry-pain-points', label: t(messages, 'products.industryPainPoints'), visible: Boolean(industryPainPointsHtml) },
  { id: 'product-features', label: t(messages, 'products.features'), visible: Boolean(productFeaturesHtml) },
  { id: 'brand--partnership', label: t(messages, 'products.brandPartnership'), visible: productFeaturesHtml.includes('brand--partnership') },
  { id: 'downloads', label: t(messages, 'products.downloads'), visible: downloadFilesList.length > 0 },
  { id: 'related-insights', label: t(messages, 'products.relatedInsights'), visible: relatedInsightItems.length > 0 },
  { id: 'faq', label: t(messages, 'products.faq'), visible: faqItems.length > 0 },
  { id: 'home-cta-title', label: t(messages, 'products.wholesaleDistribution'), visible: true },
].filter((item) => item.visible);

const productGalleryLabels = {
  previous: t(messages, 'products.previousMedia'),
  next: t(messages, 'products.nextMedia'),
  playVideo: t(messages, 'products.playVideo'),
  viewImage: t(messages, 'products.viewImage'),
  mediaCount: t(messages, 'products.mediaCount'),
};

const breadcrumbItems = [
  { label: t(messages, 'pageTitle.home'), href: '/' },
  { label: t(messages, 'pageTitle.products'), href: '/products' },
  { label: categoryName, href: `/products/${categorySlug}` },
  { label: product?.name ?? productSlug },
];
---

<BaseLayout
  title={product ? `${product.name} - ${t(messages, 'pageTitle.products')}` : t(messages, 'pageTitle.products')}
  description={productDescription}
  image={product?.cover ?? (productSeoImage ? { url: productSeoImage.src } : undefined)}
  seo={product?.seo}
  pageType="product"
  breadcrumbs={breadcrumbItems}
  messages={messages}
  locale={locale}
>
  <div class='product-detail-page container mx-auto max-w-[1440px] px-4 py-6 sm:px-6 lg:px-8 lg:py-8' data-product-detail-page>
    {product ? (
      <>
        <Breadcrumb items={breadcrumbItems} locale={locale} />

        <div class='product-detail-layout lg:grid lg:grid-cols-[minmax(150px,190px)_minmax(0,1fr)] lg:items-start lg:gap-12'>
          <aside class='mb-6 lg:mb-0 lg:sticky lg:top-[8.5rem] lg:self-start'>
            <div class='product-section-nav'>
              <nav aria-label={t(messages, 'products.sectionNavigation')} data-product-section-nav>
                <ul class='flex gap-5 overflow-x-auto py-2 lg:block lg:space-y-3 lg:overflow-visible lg:py-1'>
                  {productSectionLinks.map((item, index) => (
                    <li class='shrink-0'>
                      <a
                        href={`#${item.id}`}
                        data-product-nav-link
                        data-section-id={item.id}
                        class='block whitespace-nowrap py-1 text-base font-medium text-slate-950 transition-colors hover:text-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2'
                        aria-current={index === 0 ? 'location' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>

          <main class='min-w-0'>
            <section id='product-overview' class='scroll-mt-[8.5rem] pb-12' data-product-section='product-overview'>
              <div class='product-overview-grid flex flex-col gap-10 lg:gap-14'>
                <div class='product-overview-media min-w-0'>
                  <ProductGallery
                    media={productGalleryMedia}
                    productName={product.name ?? ''}
                    locale={locale}
                    labels={productGalleryLabels}
                  />
                </div>
                <div class='product-overview-info min-w-0 max-w-5xl'>
                  <h1 class='text-3xl font-black leading-[1.1] tracking-tight text-slate-950 sm:text-4xl lg:text-[2.75rem]'>{product.name}</h1>

                  {informationList.length > 0 && (
                    <div class='mt-8 space-y-7'>
                      {informationList.map((item) => (
                        <div>
                          {item.title && <h2 class='mb-2 text-xl font-bold leading-tight text-slate-900'>{item.title}</h2>}
                          {item.description && item.description.length > 0 && (
                            <BlocksRenderer blocks={item.description} locale={locale} class='product-summary-content' />
                          )}
                        </div>
                      ))}
                    </div>
                  )}

                  {informationList.length === 0 && productDescription && (
                    <p class='mt-6 max-w-4xl text-lg leading-[1.55] text-slate-600'>{productDescription}</p>
                  )}

                  {(holeList.length > 0 || optionsList.length > 0) && (
                    <div class='mt-8 space-y-2 text-lg leading-[1.55] text-slate-600'>
                      {holeList.map((h) => <p>{h.name ?? ''}</p>)}
                    </div>
                  )}

                  {optionsList.length > 0 && (
                    <div class='mt-6'>
                      <p class='mb-3 text-base font-semibold uppercase tracking-[0.1em] text-slate-500'>{t(messages, 'products.gritOptions')}</p>
                      <div class='flex flex-wrap gap-2'>
                        {optionsList.map((opt) => (
                          <span class='rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-base font-semibold text-slate-700 transition-colors hover:border-orange-300 hover:bg-orange-50'>
                            {opt.name ?? ''}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}

                  <!-- 行动按钮 -->
                  <div class='mt-7 flex flex-wrap gap-3'>
                    <a
                      href={toHref('/about/dealer', locale)}
                      class='inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-orange-500 px-5 py-3 font-semibold text-white transition-colors hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2'
                    >
                      <img
                        src="/images/icon-distributor.svg"
                        alt=""
                        aria-hidden="true"
                        class="h-5 w-5 shrink-0 object-contain"
                      />
                      {t(messages, 'products.wholesaleDistribution')}
                    </a>
                    <a
                      href={`${toHref('/support/customer-service', locale)}?type=buy-products&product=${encodeURIComponent(product?.name ?? '')}#contact-form`}
                      class='inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-orange-400 bg-white px-5 py-3 font-semibold text-orange-500 transition-colors hover:bg-orange-50 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2'
                    >
                      <MessageCircle class="h-5 w-5 shrink-0" />
                      {t(messages, 'products.inquire')}
                    </a>
                  </div>
                </div>
              </div>
            </section>

            {technicalDetailsList.length > 0 && (
              <section id='technical-details' class='product-content-section' data-product-section='technical-details'>
                <h2 class='mb-5 text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl'>{t(messages, 'products.technicalDetails')}</h2>
                <div class='product-spec-table w-full max-w-none overflow-hidden rounded-xl border border-slate-200 bg-white'>
              {technicalDetailsList.map((item) => (
                <div class='product-spec-row flex items-stretch border-b border-slate-200 last:border-b-0'>
                  {item.title != null && item.title !== '' && <div class='w-2/5 shrink-0 bg-slate-100 px-4 py-3 text-lg font-semibold text-slate-900 sm:w-1/3'>{item.title}</div>}
                  <div class='flex-1 px-4 py-3 text-lg leading-7 text-slate-700'>{item.description ?? ''}</div>
                </div>
              ))}
                </div>
              </section>
            )}

            {industryPainPointsHtml && (
              <section id='industry-pain-points' class='product-content-section' data-product-section='industry-pain-points'>
                <div class='max-w-[820px]'>
                  <h2 class='mb-5 text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl'>{t(messages, 'products.industryPainPoints')}</h2>
                </div>
                <div class='product-features-content article-content prose max-w-none' set:html={industryPainPointsHtml} />
              </section>
            )}

            {productFeaturesHtml && (
              <section id='product-features' class='product-content-section' data-product-section='product-features'>
                <div class='max-w-[820px]'>
                  <h2 class='mb-5 text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl'>{t(messages, 'products.features')}</h2>
                </div>
                <div
                  class='product-features-content article-content prose max-w-none'
                  set:html={productFeaturesHtml}
                />
              </section>
            )}

            {downloadFilesList.length > 0 && (
              <section id='downloads' class='product-content-section' data-product-section='downloads'>
                <div class='mb-4 flex items-center justify-between gap-4'>
                  <div>
                    <h2 class='text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl'>{t(messages, 'products.downloads')}</h2>
                  </div>
                  <a
                    href={toHref('/support/download', locale)}
                    class='flex shrink-0 items-center gap-2 text-lg font-semibold text-orange-500 transition-colors hover:text-orange-600'
                  >
                    {t(messages, 'common.viewAll')}
                    <CircleChevronRight class='h-4 w-4' />
                  </a>
                </div>
                <div class='grid gap-4 sm:grid-cols-2 lg:grid-cols-3'>
                  {downloadFilesList.map((item) => (
                    <DownloadFileCard item={item} downloadLabel={t(messages, 'footer.support.download')} />
                  ))}
                </div>
              </section>
            )}

            {relatedInsightItems.length > 0 && (
              <section id='related-insights' class='product-content-section' data-product-section='related-insights'>
                <div class='mb-5 flex items-center justify-between gap-4'>
                  <div>
                    <h2 class='text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl'>{t(messages, 'products.relatedInsights')}</h2>
                  </div>
                  <a
                    href={toHref('/about/insights', locale)}
                    class='flex shrink-0 items-center gap-2 text-lg font-semibold text-orange-500 transition-colors hover:text-orange-600'
                  >
                    {t(messages, 'common.viewAll')}
                    <CircleChevronRight class='h-4 w-4' />
                  </a>
                </div>
                <div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3'>
                  {relatedInsightItems.map((insight) => (
                    <InsightCard insight={insight} locale={locale} />
                  ))}
                </div>
              </section>
            )}

            {faqItems.length > 0 && (
              <section id='faq' class='product-content-section max-w-[820px]' data-product-section='faq'>
                <div class='mb-4 flex items-center justify-between gap-4'>
                  <div>
                    <h2 class='text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl'>{t(messages, 'products.faq')}</h2>
                  </div>
                  <a
                    href={toHref('/help', locale)}
                    class='flex shrink-0 items-center gap-2 text-base font-semibold text-orange-500 transition-colors hover:text-orange-600'
                  >
                    {t(messages, 'common.viewAll')}
                    <CircleChevronRight class='h-4 w-4' />
                  </a>
                </div>
                <div class='space-y-3'>
                  {faqItems.map((faq, idx) => (
                    <details class='rounded-xl border border-slate-200 bg-white shadow-sm'>
                      <summary class='cursor-pointer px-4 py-3 text-lg font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-inset sm:text-xl'>
                        {faq.title || `${t(messages, 'products.faq')} ${idx + 1}`}
                      </summary>
                      <div class='px-4 pb-4 text-lg leading-[1.55] text-slate-700'>
                        {faq.contentHtml && (
                          <div class='article-content prose max-w-none' set:html={faq.contentHtml} />
                        )}
                        {faq.href && (
                          <div class='mt-4'>
                            <a href={faq.href} class='flex items-center gap-2 text-lg font-medium text-orange-500 transition-colors hover:text-orange-600'>
                              {t(messages, 'common.readMore')}
                              <CircleChevronRight class='w-4 h-4' />
                            </a>
                          </div>
                        )}
                      </div>
                    </details>
                  ))}
                </div>
              </section>
            )}
          </main>
        </div>
      </>
    ) : (
      <p>{t(messages, 'search.noResults')}</p>
    )}
  </div>
</BaseLayout>

<style>
  @reference "../../../../styles/global.css";

  .product-content-section {
    @apply border-t border-slate-200 py-10;
    scroll-margin-top: 8.5rem;
  }

  .product-section-nav ul {
    scrollbar-width: none;
    scroll-padding-inline: 1rem;
  }

  .product-section-nav ul::-webkit-scrollbar {
    display: none;
  }

  .product-section-nav a[aria-current='location'] {
    @apply font-bold text-orange-500;
  }

  .product-spec-row:nth-child(even) {
    @apply bg-slate-50/70;
  }

  .product-features-content.article-content {
    @apply max-w-none text-lg leading-[1.6] text-slate-700;
  }

  .product-features-content.article-content :global(p),
  .product-features-content.article-content :global(ul),
  .product-features-content.article-content :global(ol),
  .product-features-content.article-content :global(h2),
  .product-features-content.article-content :global(h3) {
    max-width: 56rem;
  }

  .product-features-content.article-content :global(table) {
    width: 100%;
    min-width: 100%;
  }

  .product-features-content.article-content :global(img) {
    border-radius: 0;
  }

  .product-features-content :global(h2) {
    @apply mt-8 mb-4 text-2xl font-bold leading-tight text-slate-950;
  }

  .product-features-content :global(h3) {
    @apply mt-7 mb-3 text-xl font-bold leading-snug text-slate-900;
  }

  .product-features-content :global(p) {
    @apply mb-4;
  }

  .product-features-content :global(li) {
    @apply mb-2 text-lg leading-[1.6];
  }

  .product-summary-content :global(h2) {
    @apply mt-5 mb-2 text-xl font-bold leading-tight text-slate-950;
    scroll-margin-top: 7rem;
  }

  .product-summary-content :global(h3) {
    @apply mt-5 mb-2 text-lg font-bold leading-snug text-slate-900;
    scroll-margin-top: 7rem;
  }

  .product-summary-content :global(p) {
    @apply mb-3 text-lg leading-[1.55] text-slate-600;
  }

  .product-summary-content :global(ul),
  .product-summary-content :global(ol) {
    @apply my-4 pl-6;
  }

  .product-summary-content :global(li) {
    @apply mb-2 text-lg leading-[1.55];
  }

  .product-section-nav a:hover {
    @apply text-orange-500;
  }

  .product-section-nav {
    scrollbar-width: thin;
  }

  @media (min-width: 1024px) {
    .product-section-nav {
      max-height: calc(100vh - 9.5rem);
      overflow-y: auto;
    }
  }

  @media (max-width: 1023px) {
    .product-section-nav {
      position: sticky;
      top: 7.5rem;
      z-index: 20;
      max-height: none;
      overflow: visible;
    }
  }
</style>

<script is:inline>
  (function () {
    const triggerSelector = '[data-open-live-chat]';
    const waitIntervalMs = 150;
    const maxWaitMs = 5000;

    function openLiveChat() {
      const api = window.Tawk_API;
      if (!api) return false;
      if (typeof api.maximize === 'function') {
        api.maximize();
        return true;
      }
      if (typeof api.toggle === 'function') {
        api.toggle();
        return true;
      }
      return false;
    }

    document.addEventListener('click', function (event) {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest(triggerSelector);
      if (!trigger) return;

      event.preventDefault();
      if (openLiveChat()) return;

      const startedAt = Date.now();
      const timer = window.setInterval(function () {
        if (openLiveChat() || Date.now() - startedAt >= maxWaitMs) {
          window.clearInterval(timer);
        }
      }, waitIntervalMs);
    });
  })();
</script>

<script>
  document.querySelectorAll('[data-product-detail-page]').forEach((page) => {
    const links = Array.from(page.querySelectorAll('[data-product-nav-link]'));
    const sections = Array.from(page.querySelectorAll('[data-product-section]'));
    const navTargets = links
      .map((link) => document.getElementById(link.getAttribute('data-section-id') || ''))
      .filter((target) => target instanceof HTMLElement);
    const observedTargets = navTargets;

    if (links.length === 0 || sections.length === 0) return;

    let forcedActiveSection = null;
    let forcedActiveUntil = 0;

    function setActiveSection(sectionId, keepActiveLinkVisible = false) {
      links.forEach((link) => {
        const isActive = link.getAttribute('data-section-id') === sectionId;
        if (isActive) {
          link.setAttribute('aria-current', 'location');
          if (window.matchMedia('(max-width: 1023px)').matches) {
            link.scrollIntoView({ block: 'nearest', inline: 'center' });
          }
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    function updateSectionHash(sectionId) {
      const nextHash = `#${sectionId}`;
      if (window.history && typeof window.history.pushState === 'function') {
        window.history.pushState(null, '', nextHash);
        return;
      }
      if (window.location.hash !== nextHash) {
        window.location.hash = sectionId;
      }
    }

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const sectionId = link.getAttribute('data-section-id');
        const section = sectionId ? document.getElementById(sectionId) : null;
        if (!sectionId || !section) return;

        event.preventDefault();
        forcedActiveSection = sectionId;
        forcedActiveUntil = Date.now() + 2600;
        setActiveSection(sectionId, true);
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        section.scrollIntoView({ behavior, block: 'start' });
        updateSectionHash(sectionId);
      });
    });

    const hashId = window.location.hash.slice(1);
    const hasInitialHash = Boolean(hashId && navTargets.some((target) => target.id === hashId));

    function scrollToInitialHash() {
      if (!hasInitialHash) return;
      const target = document.getElementById(hashId);
      if (!target) return;

      target.scrollIntoView({ block: 'start' });
      forcedActiveSection = hashId;
      forcedActiveUntil = Date.now() + 1600;
      setActiveSection(hashId);
    }

    if (hasInitialHash) {
      setActiveSection(hashId);
      if (document.readyState === 'complete') {
        window.requestAnimationFrame(scrollToInitialHash);
      } else {
        window.addEventListener('load', scrollToInitialHash, { once: true });
      }
      window.setTimeout(scrollToInitialHash, 300);
    } else {
      setActiveSection(sections[0].id);
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visibleEntries = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          const activeEntry = visibleEntries[0];
          if (forcedActiveSection && Date.now() < forcedActiveUntil) return;
          forcedActiveSection = null;
          if (activeEntry?.target instanceof HTMLElement) {
            setActiveSection(activeEntry.target.id);
          }
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: [0, 0.25, 0.75] },
      );

      observedTargets.forEach((target) => observer.observe(target));
    }
  });
</script>
